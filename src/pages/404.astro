---
import Layout from '../layouts/Layout.astro';
import FidicIcon from '../components/FidicIcon.astro';
import { site, comingSoon } from '../data/site';
import { getLangFromPath, localizePath, stripLocale, type Lang } from '../i18n/ui';

const lang = getLangFromPath(Astro.url.pathname);
const requestedPath = stripLocale(Astro.url.pathname || '/route-not-certified');
const canonicalMissingPath = requestedPath.startsWith('/404') ? '/route-not-certified' : requestedPath;
const notFoundLangUrls: Record<Lang, string> = {
  ru: localizePath(canonicalMissingPath, 'ru'),
  en: localizePath(canonicalMissingPath, 'en'),
  uz: localizePath(canonicalMissingPath, 'uz'),
};

const copy = {
  ru: {
    title: '404 — route not certified',
    description: 'Страница не найдена. Вернитесь к базе знаний FIDIC.uz, инструментам, справочнику clauses или бесплатным материалам.',
    eyebrow: 'Route determination failed',
    h1: 'Этот мост ещё не построен',
    lead: 'Похоже, ссылка ушла в старую редакцию контракта или потерялась между notice, claim file и DAAB. Выберите ближайший безопасный маршрут ниже.',
    home: 'На главную',
    risk: 'Contract Risk Score',
    console: 'FIDIC route console',
    requested: 'Requested path',
    requestedValue: 'not certified',
    action: 'Recommended action',
    actionValue: 'open knowledge map',
    status: 'Claim status',
    statusValue: 'preserve evidence',
    linksLabel: 'Быстрые разделы',
    links: [
      ['knowledge', '/knowledge/', 'book', 'База знаний', 'Статьи по claims, EOT, DAAB и книгам FIDIC'],
      ['tools', '/tools/', 'tools', 'Инструменты', 'Калькуляторы, Risk Score и checklists'],
      ['clauses', '/clauses/', 'timeline', 'Справочник clauses', 'Быстрый путь к ключевым пунктам FIDIC'],
      ['resources', '/resources/', 'claim', 'Материалы', 'Playbook, templates и PDF-ready resources'],
    ],
  },
  en: {
    title: '404 — route not certified',
    description: 'Page not found. Return to the FIDIC.uz knowledge hub, tools, clauses guide or practical resources.',
    eyebrow: 'Route determination failed',
    h1: 'This bridge is not built yet',
    lead: 'Looks like the link moved to an old contract edition or got lost between the notice, claim file and DAAB. Choose the nearest safe route below.',
    home: 'Home',
    risk: 'Contract Risk Score',
    console: 'FIDIC route console',
    requested: 'Requested path',
    requestedValue: 'not certified',
    action: 'Recommended action',
    actionValue: 'open knowledge map',
    status: 'Claim status',
    statusValue: 'preserve evidence',
    linksLabel: 'Quick sections',
    links: [
      ['knowledge', '/knowledge/', 'book', 'Knowledge Hub', 'Articles on claims, EOT, DAAB and FIDIC books'],
      ['tools', '/tools/', 'tools', 'Tools', 'Calculators, Risk Score and checklists'],
      ['clauses', '/clauses/', 'timeline', 'Clause guide', 'Fast access to key FIDIC clauses'],
      ['resources', '/resources/', 'claim', 'Resources', 'Playbook, templates and PDF-ready materials'],
    ],
  },
  uz: {
    title: '404 — route not certified',
    description: 'Sahifa topilmadi. FIDIC.uz bilimlar bazasi, vositalar, clauses qo‘llanmasi yoki amaliy materiallarga qayting.',
    eyebrow: 'Route determination failed',
    h1: 'Bu ko‘prik hali qurilmagan',
    lead: 'Havola eski kontrakt tahririga o‘tgan yoki notice, claim file va DAAB orasida yo‘qolgan ko‘rinadi. Quyida eng yaqin xavfsiz yo‘lni tanlang.',
    home: 'Bosh sahifa',
    risk: 'Contract Risk Score',
    console: 'FIDIC route console',
    requested: 'Requested path',
    requestedValue: 'not certified',
    action: 'Recommended action',
    actionValue: 'open knowledge map',
    status: 'Claim status',
    statusValue: 'preserve evidence',
    linksLabel: 'Tezkor bo‘limlar',
    links: [
      ['knowledge', '/knowledge/', 'book', 'Bilimlar bazasi', 'Claims, EOT, DAAB va FIDIC kitoblari bo‘yicha maqolalar'],
      ['tools', '/tools/', 'tools', 'Vositalar', 'Kalkulyatorlar, Risk Score va checklistlar'],
      ['clauses', '/clauses/', 'timeline', 'Clauses qo‘llanmasi', 'Asosiy FIDIC bandlariga tezkor yo‘l'],
      ['resources', '/resources/', 'claim', 'Materiallar', 'Playbook, templates va PDF-ready resurslar'],
    ],
  },
};

// When the public site is gated (СКОРО), the 404 must not advertise gated
// sections: only the routes that stay open — home (СКОРО), certificate
// verification and the claim checklist. /verify/ exists at root only and
// must never be locale-prefixed.
const verifyLabel: Record<Lang, string> = { ru: 'Проверить сертификат', en: 'Verify certificate', uz: 'Sertifikatni tekshirish' };
const gatedLinks: Record<Lang, string[][]> = {
  ru: [
    ['verify', '/verify/', 'shield', 'Проверить сертификат', 'Реестр сертификатов Bridge Consult: QR или код'],
    ['checklist', '/resources/claim-checklist/', 'claim', 'Claim checklist', 'Бесплатный чеклист готовности claim'],
  ],
  en: [
    ['verify', '/verify/', 'shield', 'Verify certificate', 'Bridge Consult certificate registry: QR or code'],
    ['checklist', '/resources/claim-checklist/', 'claim', 'Claim checklist', 'Free claim readiness checklist'],
  ],
  uz: [
    ['verify', '/verify/', 'shield', 'Sertifikatni tekshirish', 'Bridge Consult sertifikat reestri: QR yoki kod'],
    ['checklist', '/resources/claim-checklist/', 'claim', 'Claim checklist', 'Bepul claim tayyorgarligi cheklisti'],
  ],
};
const effectiveCopy = {
  ru: { ...copy.ru, risk: comingSoon ? verifyLabel.ru : copy.ru.risk, links: comingSoon ? gatedLinks.ru : copy.ru.links },
  en: { ...copy.en, risk: comingSoon ? verifyLabel.en : copy.en.risk, links: comingSoon ? gatedLinks.en : copy.en.links },
  uz: { ...copy.uz, risk: comingSoon ? verifyLabel.uz : copy.uz.risk, links: comingSoon ? gatedLinks.uz : copy.uz.links },
};

const c = effectiveCopy[lang];
const localizeSafe = (path: string, l: Lang) => (path.startsWith('/verify') ? path : localizePath(path, l));
const riskHref = comingSoon ? '/verify/' : localizePath('/tools/contract-risk-score/', lang);
---

<Layout
  lang={lang}
  title={`${c.title} | ${site.name}`}
  description={c.description}
  forceNoindex
  noHeaderOffset
  alwaysOpen
  bare
  langUrls={notFoundLangUrls}
>
  <section class="not-found">
    <a href={localizePath('/', lang)} class="not-found__brand" id="nf-brand" aria-label="FIDIC.uz">
      <span class="not-found__brand-mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 6.5C7 4.8 9.5 4.8 12 6.2C14.5 4.8 17 4.8 20 6.5V18C17 16.6 14.5 16.6 12 18C9.5 16.6 7 16.6 4 18V6.5Z" stroke="var(--color-brass)" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 6.2V18" stroke="var(--color-brass)" stroke-width="1.4"/></svg>
      </span>
      <span class="not-found__brand-text">FIDIC<b>.uz</b></span>
    </a>
    <nav class="not-found__langs" aria-label="Language">
      <a href="/" data-lang-switch>RU</a>
      <a href="/en/" data-lang-switch>EN</a>
      <a href="/uz/" data-lang-switch>UZ</a>
    </nav>
    <canvas class="not-found__canvas" data-not-found-3d aria-hidden="true"></canvas>
    <div class="not-found__aurora" aria-hidden="true"></div>
    <div class="not-found__grid" aria-hidden="true"></div>
    <div class="not-found__noise" aria-hidden="true"></div>

    <div class="not-found__inner">
      <div class="not-found__copy">
        <p class="eyebrow" id="nf-eyebrow">{c.eyebrow}</p>
        <h1>
          <span>404</span>
          <b id="nf-h1">{c.h1}</b>
        </h1>
        <p id="nf-lead">{c.lead}</p>
        <div class="not-found__actions">
          <a href={localizePath('/', lang)} class="btn btn-primary magnetic" id="nf-home">{c.home}</a>
          <a href={riskHref} class="btn btn-ghost" id="nf-risk">{c.risk}</a>
        </div>
      </div>

      <aside class="not-found__panel" aria-label={c.console} id="nf-panel">
        <div class="not-found__panel-head">
          <span></span>
          <strong id="nf-console">{c.console}</strong>
        </div>
        <dl>
          <div>
            <dt id="nf-requested">{c.requested}</dt>
            <dd id="nf-requested-value">{c.requestedValue}</dd>
          </div>
          <div>
            <dt id="nf-action">{c.action}</dt>
            <dd id="nf-action-value">{c.actionValue}</dd>
          </div>
          <div>
            <dt id="nf-status">{c.status}</dt>
            <dd id="nf-status-value">{c.statusValue}</dd>
          </div>
        </dl>
      </aside>
    </div>

    <div class="not-found__links" aria-label={c.linksLabel} id="nf-links">
      {c.links.map((item, index) => (
        <a href={localizeSafe(item[1], lang)} class="not-found__link tilt" style={`--i:${index}`} data-nf-link={index}>
          <span><FidicIcon name={item[2]} /></span>
          <strong>{item[3]}</strong>
          <small>{item[4]}</small>
        </a>
      ))}
    </div>
  </section>

  <script>
    import '../scripts/notFound3d.js';
  </script>

  <script is:inline define:vars={{ copy: effectiveCopy, gated: comingSoon }}>
    (function () {
      var locales = ['ru', 'en', 'uz'];
      var short = { ru: 'RU', en: 'EN', uz: 'UZ' };
      var lang = location.pathname.indexOf('/en/') === 0 || location.pathname === '/en' ? 'en' : location.pathname.indexOf('/uz/') === 0 || location.pathname === '/uz' ? 'uz' : 'ru';
      var canonical = location.pathname.replace(/^\/(en|uz)(?=\/|$)/, '') || '/route-not-certified/';
      if (canonical === '/' || canonical === '/404/' || canonical === '/404.html') canonical = '/route-not-certified/';
      if (!canonical.endsWith('/')) canonical += '/';

      function localize(path, target) {
        var base = path || '/';
        if (!base.startsWith('/')) base = '/' + base;
        if (!base.endsWith('/')) base += '/';
        // /verify lives at root only — never locale-prefix it.
        if (base.indexOf('/verify') === 0 || target === 'ru') return base;
        return base === '/' ? '/' + target + '/' : '/' + target + base;
      }

      function setText(id, value) {
        var node = document.getElementById(id);
        if (node) node.textContent = value;
      }

      var c = copy[lang] || copy.ru;
      document.documentElement.lang = lang;
      document.title = c.title + ' | FIDIC.uz';
      setText('nf-eyebrow', c.eyebrow);
      setText('nf-h1', c.h1);
      setText('nf-lead', c.lead);
      setText('nf-home', c.home);
      setText('nf-risk', c.risk);
      setText('nf-console', c.console);
      setText('nf-requested', c.requested);
      setText('nf-requested-value', c.requestedValue);
      setText('nf-action', c.action);
      setText('nf-action-value', c.actionValue);
      setText('nf-status', c.status);
      setText('nf-status-value', c.statusValue);
      var panel = document.getElementById('nf-panel');
      if (panel) panel.setAttribute('aria-label', c.console);
      var links = document.getElementById('nf-links');
      if (links) links.setAttribute('aria-label', c.linksLabel);
      c.links.forEach(function (item, index) {
        var link = document.querySelector('[data-nf-link="' + index + '"]');
        if (!link) return;
        link.href = localize(item[1], lang);
        var strong = link.querySelector('strong');
        var small = link.querySelector('small');
        if (strong) strong.textContent = item[3];
        if (small) small.textContent = item[4];
      });
      var home = document.getElementById('nf-home');
      var risk = document.getElementById('nf-risk');
      var brand = document.getElementById('nf-brand');
      if (home) home.href = localize('/', lang);
      if (brand) brand.href = localize('/', lang);
      if (risk) risk.href = gated ? '/verify/' : localize('/tools/contract-risk-score/', lang);

      document.querySelectorAll('[data-lang-switch]').forEach(function (a) {
        var code = (a.textContent || '').trim().toLowerCase();
        if (!locales.includes(code)) return;
        a.href = localize(canonical, code);
        var active = code === lang;
        a.setAttribute('aria-current', active ? 'true' : 'false');
        a.classList.toggle('is-active-404', active);
        a.textContent = short[code];
      });

      // Log which dead URLs people actually hit, so we know what to build next.
      try {
        var missPath = location.pathname + location.search;
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'page_not_found', {
            page_path: missPath,
            page_referrer: document.referrer || '(none)',
          });
        }
        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({ event: 'page_not_found', not_found_path: missPath });
        }
      } catch (e) {}
    })();
  </script>

  <style>
    .not-found {
      position: relative;
      min-height: 100svh;
      overflow: hidden;
      padding: clamp(7.5rem, 12vw, 9rem) 1.25rem 3rem;
      background:
        radial-gradient(circle at 72% 22%, rgba(201,164,92,0.18), transparent 25rem),
        radial-gradient(circle at 18% 80%, rgba(91,140,255,0.12), transparent 28rem),
        linear-gradient(135deg, #080a0f 0%, #11110f 48%, #07080b 100%);
      color: var(--color-fg);
      isolation: isolate;
    }

    .not-found__brand {
      position: absolute;
      top: clamp(1.1rem, 3vw, 1.9rem);
      left: clamp(1.1rem, 3vw, 2rem);
      z-index: 5;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }

    .not-found__brand-mark {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border: 1px solid color-mix(in oklab, var(--color-brass) 40%, var(--color-line));
      border-radius: 0.55rem;
      background: rgba(8, 10, 15, 0.6);
    }

    .not-found__brand-text {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--color-fg);
    }

    .not-found__brand-text b {
      color: var(--color-brass);
      font: inherit;
    }

    .not-found__langs {
      position: absolute;
      top: clamp(1.1rem, 3vw, 1.9rem);
      right: clamp(1.1rem, 3vw, 2rem);
      z-index: 5;
      display: flex;
      gap: 0.4rem;
    }

    .not-found__langs a {
      border: 1px solid var(--color-line);
      border-radius: 999px;
      padding: 0.32rem 0.72rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-fg-dim);
      text-decoration: none;
      background: rgba(8, 10, 15, 0.55);
      transition: color 0.25s, border-color 0.25s, background 0.25s;
    }

    .not-found__langs a:hover {
      color: var(--color-fg);
      border-color: var(--color-brass);
    }

    .not-found__langs a.is-active-404 {
      background: var(--color-brass);
      border-color: var(--color-brass);
      color: #1a1206;
    }

    .not-found__canvas,
    .not-found__aurora,
    .not-found__grid,
    .not-found__noise {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .not-found__canvas {
      z-index: 0;
      width: 100%;
      height: 100%;
      opacity: 0.96;
      mix-blend-mode: screen;
    }

    .not-found__aurora {
      z-index: 1;
      opacity: 0.72;
      background:
        radial-gradient(circle at 70% 30%, rgba(216,179,95,0.24), transparent 18rem),
        radial-gradient(circle at 46% 52%, rgba(108,151,255,0.18), transparent 22rem),
        conic-gradient(from 120deg at 58% 42%, transparent, rgba(216,179,95,0.16), transparent 38%, rgba(108,151,255,0.12), transparent 66%);
      filter: blur(22px) saturate(1.2);
      mask-image: radial-gradient(circle at 56% 42%, black, transparent 72%);
      animation: routeGlow 9s ease-in-out infinite alternate;
    }

    .not-found__grid {
      z-index: 0;
      background:
        linear-gradient(rgba(201,164,92,0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,164,92,0.05) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(circle at 50% 44%, black, transparent 72%);
    }

    .not-found__noise {
      z-index: 1;
      opacity: 0.16;
      background-image:
        repeating-linear-gradient(0deg, rgba(255,255,255,0.08) 0 1px, transparent 1px 3px);
      mix-blend-mode: overlay;
    }

    .not-found__inner {
      display: grid;
      gap: 2rem;
      align-items: end;
      max-width: 1220px;
      margin: 0 auto;
      position: relative;
      z-index: 3;
    }

    .not-found__copy {
      max-width: 790px;
      text-shadow: 0 18px 54px rgba(0,0,0,0.72);
    }

    .not-found h1 {
      margin-top: 1rem;
      color: var(--color-fg);
      font-family: var(--font-display);
      font-size: clamp(3rem, 8vw, 6.8rem);
      font-weight: 800;
      line-height: 0.92;
      letter-spacing: 0;
    }

    .not-found h1 span {
      display: block;
      color: transparent;
      font-size: clamp(5.8rem, 15vw, 11.5rem);
      line-height: 0.78;
      -webkit-text-stroke: 1px rgba(216,179,95,0.76);
      text-shadow: 0 0 44px rgba(201,164,92,0.2);
    }

    .not-found h1 b {
      display: block;
      font: inherit;
    }

    .not-found__copy p:not(.eyebrow) {
      max-width: 660px;
      margin-top: 1.35rem;
      color: var(--color-fg-dim);
      font-size: clamp(1rem, 1.6vw, 1.18rem);
      line-height: 1.72;
    }

    .not-found__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-top: 1.7rem;
    }

    .not-found__panel {
      max-width: 25rem;
      border: 1px solid color-mix(in oklab, var(--color-brass) 28%, var(--color-line));
      border-radius: 1rem;
      padding: 1rem;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025)),
        rgba(8,10,15,0.68);
      box-shadow: 0 24px 80px rgba(0,0,0,0.34);
      backdrop-filter: blur(18px);
      position: relative;
      overflow: hidden;
    }

    .not-found__panel::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      background: linear-gradient(120deg, transparent 0 26%, rgba(216,179,95,0.22) 42%, transparent 58% 100%);
      transform: translateX(-70%);
      animation: consoleScan 4.8s ease-in-out infinite;
      pointer-events: none;
    }

    .not-found__panel-head {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      border-bottom: 1px solid var(--color-line);
      padding-bottom: 0.8rem;
      color: var(--color-fg);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .not-found__panel-head span {
      width: 0.68rem;
      height: 0.68rem;
      border-radius: 50%;
      background: var(--color-fidic-red);
      box-shadow: 1rem 0 0 var(--color-fidic-yellow), 2rem 0 0 var(--color-fidic-green);
    }

    .not-found__panel dl {
      display: grid;
      gap: 0.8rem;
      margin-top: 1rem;
    }

    .not-found__panel div {
      display: grid;
      gap: 0.18rem;
    }

    .not-found__panel dt {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .not-found__panel dd {
      margin: 0;
      color: var(--color-brass-bright);
      font-weight: 700;
    }

    .not-found__links {
      display: grid;
      gap: 0.9rem;
      max-width: 1220px;
      margin: clamp(2rem, 7vw, 5rem) auto 0;
      position: relative;
      z-index: 3;
    }

    .not-found__link {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.18rem 0.75rem;
      min-height: 8.4rem;
      border: 1px solid color-mix(in oklab, var(--color-brass) 16%, var(--color-line));
      border-radius: 0.85rem;
      padding: 1rem;
      color: var(--color-fg);
      background: rgba(255,255,255,0.035);
      transform-style: preserve-3d;
      transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
      box-shadow: 0 20px 70px rgba(0,0,0,0.18);
    }

    .not-found__link:hover,
    .not-found__link:focus-visible {
      border-color: var(--color-brass);
      background: rgba(201,164,92,0.07);
      transform: translateY(-4px);
      box-shadow: 0 26px 90px rgba(216,179,95,0.12);
    }

    .not-found__link span {
      grid-row: 1 / 3;
      display: inline-grid;
      place-items: center;
      width: 2.45rem;
      height: 2.45rem;
      border: 1px solid var(--color-line);
      border-radius: 0.7rem;
      color: var(--color-brass);
      background: rgba(255,255,255,0.035);
    }

    .not-found__link :global(.fidic-icon) {
      width: 1.15rem;
      height: 1.15rem;
    }

    .not-found__link strong {
      align-self: end;
      font-family: var(--font-display);
      font-size: 1.18rem;
      line-height: 1.1;
    }

    .not-found__link small {
      color: var(--color-muted);
      line-height: 1.45;
    }

    @media (min-width: 760px) {
      .not-found__links {
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      }
    }

    @media (min-width: 980px) {
      .not-found__inner {
        grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.36fr);
      }

      .not-found__panel {
        justify-self: end;
        margin-bottom: 1rem;
      }
    }

    @keyframes routeGlow {
      from {
        transform: translate3d(-2%, -1%, 0) scale(0.98) rotate(-2deg);
        opacity: 0.58;
      }

      to {
        transform: translate3d(2%, 1%, 0) scale(1.04) rotate(2deg);
        opacity: 0.82;
      }
    }

    @keyframes consoleScan {
      0%, 38% {
        transform: translateX(-72%);
        opacity: 0;
      }

      52% {
        opacity: 1;
      }

      100% {
        transform: translateX(72%);
        opacity: 0;
      }
    }

    @media (max-width: 520px), (prefers-reduced-motion: reduce) {
      .not-found__canvas {
        display: none;
      }

      .not-found {
        background:
