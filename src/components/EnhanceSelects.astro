---
// Progressive enhancement: replaces native <select> (dropdowns whose open list
// the OS renders and CSS can't style) with a fully themed, accessible custom
// listbox. The native <select> stays in the DOM as the source of truth, so all
// existing value-reading and change/input listeners keep working. If JS is off
// or fails, the native control still works.
//
// Targets: any <select> matching the `selector` prop. Defaults cover the Risk
// Score form and any select carrying the shared .ff-select class.
interface Props { selector?: string }
const { selector = '.score-form select, select.ff-select' } = Astro.props;
---

<script is:inline define:vars={{ selector }}>
  (function () {
    if (window.__fidicCSelectBound) return;
    window.__fidicCSelectBound = true;

    function enhance(select) {
      if (select.dataset.cselectDone === '1') return;
      if (select.multiple || select.size > 1) return;
      select.dataset.cselectDone = '1';

      var wrap = document.createElement('div');
      wrap.className = 'cselect';

      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'cselect__button';
      button.setAttribute('aria-haspopup', 'listbox');
      button.setAttribute('aria-expanded', 'false');
      if (select.id) button.setAttribute('aria-labelledby', select.id);

      var valueSpan = document.createElement('span');
      valueSpan.className = 'cselect__value';
      button.appendChild(valueSpan);

      var caret = document.createElement('span');
      caret.className = 'cselect__caret';
      caret.setAttribute('aria-hidden', 'true');
      caret.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
      button.appendChild(caret);

      var list = document.createElement('ul');
      list.className = 'cselect__list';
      list.setAttribute('role', 'listbox');
      list.setAttribute('tabindex', '-1');
      list.hidden = true;

      var options = Array.prototype.slice.call(select.options);
      var items = [];
      options.forEach(function (opt, i) {
        var li = document.createElement('li');
        li.className = 'cselect__opt';
        li.setAttribute('role', 'option');
        li.setAttribute('data-index', String(i));
        li.textContent = opt.textContent;
        li.setAttribute('aria-selected', opt.selected ? 'true' : 'false');
        list.appendChild(li);
        items.push(li);
      });

      // Hide the native control but keep it operable/accessible in the tree.
      select.classList.add('cselect__native');
      select.setAttribute('tabindex', '-1');
      select.setAttribute('aria-hidden', 'true');

      select.parentNode.insertBefore(wrap, select);
      wrap.appendChild(button);
      wrap.appendChild(select);
      wrap.appendChild(list);

      var open = false;
      var activeIndex = select.selectedIndex < 0 ? 0 : select.selectedIndex;

      function syncFromNative() {
        var idx = select.selectedIndex < 0 ? 0 : select.selectedIndex;
        valueSpan.textContent = options[idx] ? options[idx].textContent : '';
        items.forEach(function (li, i) { li.setAttribute('aria-selected', i === idx ? 'true' : 'false'); });
        activeIndex = idx;
      }

      function setActive(i) {
        activeIndex = Math.max(0, Math.min(items.length - 1, i));
        items.forEach(function (li, idx) { li.classList.toggle('is-active', idx === activeIndex); });
        var el = items[activeIndex];
        if (el) {
          list.setAttribute('aria-activedescendant', '');
          el.scrollIntoView({ block: 'nearest' });
        }
      }

      function openList() {
        if (open) return;
        open = true;
        list.hidden = false;
        wrap.classList.add('is-open');
        button.setAttribute('aria-expanded', 'true');
        setActive(select.selectedIndex < 0 ? 0 : select.selectedIndex);
        document.addEventListener('mousedown', onOutside, true);
      }

      function closeList(focusButton) {
        if (!open) return;
        open = false;
        list.hidden = true;
        wrap.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
        document.removeEventListener('mousedown', onOutside, true);
        if (focusButton) button.focus();
      }

      function choose(i) {
        if (i < 0 || i >= options.length) return;
        select.selectedIndex = i;
        select.dispatchEvent(new Event('input', { bubbles: true }));
        select.dispatchEvent(new Event('change', { bubbles: true }));
        syncFromNative();
        closeList(true);
      }

      function onOutside(e) { if (!wrap.contains(e.target)) closeList(false); }

      button.addEventListener('click', function () { open ? closeList(true) : openList(); });

      button.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openList();
        }
      });

      list.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
        else if (e.key === 'End') { e.preventDefault(); setActive(items.length - 1); }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(activeIndex); }
        else if (e.key === 'Escape' || e.key === 'Tab') { closeList(e.key === 'Escape'); }
        else if (e.key.length === 1) {
          var ch = e.key.toLowerCase();
          for (var k = 1; k <= items.length; k++) {
            var idx = (activeIndex + k) % items.length;
            if ((items[idx].textContent || '').trim().toLowerCase().indexOf(ch) === 0) { setActive(idx); break; }
          }
        }
      });

      items.forEach(function (li, i) {
        li.addEventListener('click', function () { choose(i); });
        li.addEventListener('mousemove', function () { setActive(i); });
      });

      // When the list opens, move focus into it for keyboard control.
      button.addEventListener('click', function () { if (open) list.focus(); });

      // Keep the custom UI in sync if the native value is changed elsewhere
      // (e.g. the Risk Score reset button dispatches 'change').
      select.addEventListener('change', syncFromNative);

      syncFromNative();
    }

    function run() {
      document.querySelectorAll(selector).forEach(enhance);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>

<style is:global>
  .cselect {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  /* Native control kept for semantics/value, hidden from view. */
  .cselect__native {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .cselect__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.15rem;
    padding: 0 0.95rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)), var(--color-ink-2);
    color: var(--color-fg);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out-expo), box-shadow 0.2s var(--ease-out-expo);
  }

  .cselect__button:hover {
    border-color: color-mix(in oklab, var(--color-brass) 45%, var(--color-line));
  }

  .cselect__button:focus-visible {
    outline: none;
    border-color: var(--color-brass);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brass) 22%, transparent);
  }

  .cselect__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cselect__caret {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-brass);
    transition: transform 0.22s var(--ease-out-expo);
  }

  .cselect.is-open .cselect__caret {
    transform: rotate(180deg);
  }

  .cselect__list {
    position: absolute;
    z-index: 70;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    max-height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border: 1px solid color-mix(in oklab, var(--color-brass) 32%, var(--color-line));
    border-radius: 0.8rem;
    background: var(--color-ink-2);
    box-shadow: 0 1.6rem 3.4rem rgba(0, 0, 0, 0.45);
    outline: none;
    animation: cselectIn 0.16s var(--ease-out-expo);
  }

  @keyframes cselectIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cselect__opt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.55rem;
    color: var(--color-fg-dim);
    font-size: 0.92rem;
    line-height: 1.35;
    cursor: pointer;
  }

  .cselect__opt.is-active {
    background: color-mix(in oklab, var(--color-brass) 14%, transparent);
    color: var(--color-fg);
  }

  .cselect__opt[aria-selected="true"] {
    color: var(--color-brass-bright);
    font-weight: 600;
  }

  .cselect__opt[aria-selected="true"]::after {
    content: "✓";
    margin-left: auto;
    color: var(--color-brass);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cselect__list { animation: none; }
    .cselect__caret { transition: none; }
  }
</style>
