---
import { getDisputeLadder } from '../data/clauses';
import { type Lang, defaultLang, useTranslations, localizePath } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const disputeLadder = getDisputeLadder(lang);
const daabHref = localizePath('/knowledge/daab-explained', lang);
---
<section class="section relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-20">
      <div class="reveal lg:col-span-4">
        <p class="eyebrow mb-4">{t('ladder.eyebrow')}</p>
        <h2 class="font-display text-4xl font-700 leading-[1.05] tracking-tight text-fg md:text-5xl">{t('ladder.h2')}</h2>
        <p class="mt-5 leading-relaxed text-fg-dim">{t('ladder.intro')}</p>
        <a href={daabHref} class="link-underline mt-7 inline-flex items-center gap-2 font-600 text-brass">
          {t('ladder.link')}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- The step markers took an 88px gutter out of a 393px screen, leaving
           the card text a 270px column. Below sm they shrink and tuck in. -->
      <div class="lg:col-span-8">
        <ol class="ladder relative">
          {disputeLadder.map((s, i) => (
            <li class="ladder__step reveal group relative flex gap-3 pb-5 last:pb-0 sm:gap-5 sm:pb-8" data-delay={i * 70}>
              <!-- connector -->
              {i < disputeLadder.length - 1 && (
                <span class="ladder__line absolute top-11 h-[calc(100%-2rem)] w-px bg-line sm:top-14 sm:h-[calc(100%-2.5rem)]"></span>
              )}
              <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line bg-ink font-mono text-xs font-600 text-brass transition-colors group-hover:border-brass sm:h-14 sm:w-14 sm:text-sm">{s.step}</span>
              <div class="card min-w-0 flex-1 p-4 sm:p-5">
                <h3 class="font-display text-lg font-700 text-fg">{s.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-fg-dim">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <style>
    /* Centre of the marker: 1.25rem on mobile (h-10), 1.75rem from sm (h-14). */
    .ladder__line {
      left: calc(1.25rem - 0.5px);
    }

    @media (min-width: 640px) {
      .ladder__line {
        left: calc(1.75rem - 0.5px);
      }
    }
  </style>
</section>
