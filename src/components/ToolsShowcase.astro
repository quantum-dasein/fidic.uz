---
// One compact "tools ecosystem" section for the homepage — replaces the five
// stacked full-width tool teasers that made the page feel endless.
import FidicIcon from './FidicIcon.astro';
import { type Lang, defaultLang, localizePath } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;

const t = {
  ru: {
    eyebrow: 'FIDIC.uz Tools',
    h2: 'Инструменты для контрактной команды',
    lead: 'Не просто читать статьи, а быстро проверять: tender package, сроки уведомлений, готовность claim и выбор формы FIDIC — всё в одной экосистеме.',
    all: 'Все инструменты',
    score: 'Contract Risk Score',
    open: 'Открыть',
    items: [
      ['/tools/tender-risk-lab', 'shield', 'Tender Risk Lab', 'Проверка tender package до подачи цены: Contract Data, securities, ESHS, DAAB.'],
      ['/tools/tender-clarification-generator', 'question', 'Clarification Generator', 'Вопросы к тендерной документации и commercial assumptions до дедлайна.'],
      ['/tools/claim-readiness', 'claim', 'Claim Readiness', 'Самодиагностика claim: notices, records, causation, quantum.'],
      ['/tools/notice-deadline', 'timeline', 'Notice Deadline', 'Сроки notice (28 дней) и detailed claim (84 дня) по дате события.'],
      ['/tools/book-selector', 'book', 'Book Selector', '6 вопросов — и рекомендация формы: Red, Yellow, Silver, Pink или Green.'],
      ['/tools/calculators', 'calculator', 'Калькуляторы', 'LD против cap, IPC, таймлайн DAAB и просрочка с EOT.'],
    ],
  },
  en: {
    eyebrow: 'FIDIC.uz Tools',
    h2: 'Tools for the contract team',
    lead: 'Not just articles: check the tender package, notice deadlines, claim readiness and the right FIDIC form — one ecosystem.',
    all: 'All tools',
    score: 'Contract Risk Score',
    open: 'Open',
    items: [
      ['/tools/tender-risk-lab', 'shield', 'Tender Risk Lab', 'Screen the tender package before pricing: Contract Data, securities, ESHS, DAAB.'],
      ['/tools/tender-clarification-generator', 'question', 'Clarification Generator', 'Questions for the tender documents and commercial assumptions before the deadline.'],
      ['/tools/claim-readiness', 'claim', 'Claim Readiness', 'Claim self-diagnosis: notices, records, causation, quantum.'],
      ['/tools/notice-deadline', 'timeline', 'Notice Deadline', 'Notice (28 days) and detailed claim (84 days) deadlines from the event date.'],
      ['/tools/book-selector', 'book', 'Book Selector', '6 questions — a recommended form: Red, Yellow, Silver, Pink or Green.'],
      ['/tools/calculators', 'calculator', 'Calculators', 'LD vs cap, IPC, DAAB timeline and delay with EOT.'],
    ],
  },
  uz: {
    eyebrow: 'FIDIC.uz Tools',
    h2: 'Kontrakt jamoasi uchun vositalar',
    lead: 'Faqat maqolalar emas: tender package, notice muddatlari, claim tayyorligi va FIDIC formasini tanlash — bitta ekotizimda.',
    all: 'Barcha vositalar',
    score: 'Contract Risk Score',
    open: 'Ochish',
    items: [
      ['/tools/tender-risk-lab', 'shield', 'Tender Risk Lab', 'Narxdan oldin tender paketini tekshirish: Contract Data, securities, ESHS, DAAB.'],
      ['/tools/tender-clarification-generator', 'question', 'Clarification Generator', 'Deadline gacha tender hujjatlariga savollar va commercial assumptions.'],
      ['/tools/claim-readiness', 'claim', 'Claim Readiness', 'Claim oʻz-oʻzini tekshirish: notices, records, causation, quantum.'],
      ['/tools/notice-deadline', 'timeline', 'Notice Deadline', 'Hodisa sanasidan notice (28 kun) va detailed claim (84 kun) muddatlari.'],
      ['/tools/book-selector', 'book', 'Book Selector', '6 savol — tavsiya etilgan forma: Red, Yellow, Silver, Pink yoki Green.'],
      ['/tools/calculators', 'calculator', 'Kalkulyatorlar', 'LD vs cap, IPC, DAAB taymlayni va EOT bilan kechikish.'],
    ],
  },
}[lang];

const toolsHref = localizePath('/tools', lang);
const scoreHref = localizePath('/tools/contract-risk-score', lang);

// Per-card accent, cycling through the FIDIC rainbow palette.
const accents = [
  'var(--color-fidic-red)',
  'var(--color-fidic-yellow)',
  'var(--color-blueprint)',
  'var(--color-fidic-green)',
  'var(--color-fidic-emerald)',
  'var(--color-brass)',
];
---

<section id="tools" class="section relative overflow-hidden">
  <div class="absolute inset-0 bp-grid opacity-30"></div>
  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal tshow__head">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">{t.eyebrow}</p>
        <h2 class="font-display text-4xl font-700 leading-tight tracking-tight text-fg md:text-5xl">{t.h2}</h2>
        <p class="mt-4 text-lg leading-relaxed text-fg-dim">{t.lead}</p>
      </div>
      <div class="tshow__actions">
        <a href={scoreHref} class="btn btn-ghost">{t.score}</a>
        <a href={toolsHref} class="btn btn-primary">{t.all} →</a>
      </div>
    </div>

    <div class="reveal tshow__grid" data-delay="120">
      {t.items.map(([href, icon, title, desc], i) => (
        <a href={localizePath(href, lang)} class="tshow__card" style={`--accent: ${accents[i % accents.length]}`}>
          <span class="tshow__top">
            <span class="tshow__icon" aria-hidden="true"><FidicIcon name={icon} /></span>
            <span class="tshow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <strong>{title}</strong>
          <p>{desc}</p>
          <em>{t.open} →</em>
          <span class="tshow__rail" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tshow__head {
    display: grid;
    gap: 1.3rem;
    align-items: end;
    margin-bottom: 1.8rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 1.15rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 90% 0%, rgba(201,164,92,0.12), transparent 20rem),
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.01));
  }

  .tshow__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .tshow__grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .tshow__card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.6rem;
    overflow: hidden;
    border: 1px solid var(--color-line-soft);
    border-radius: 0.9rem;
    padding: 1.2rem 1.2rem 1.3rem;
    background:
      radial-gradient(circle at 90% 0%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 12rem),
      linear-gradient(180deg, color-mix(in oklab, var(--color-ink-2) 92%, transparent), var(--color-ink));
    color: var(--color-fg);
    text-decoration: none;
    transition: transform 0.28s var(--ease-out-expo), border-color 0.28s var(--ease-out-expo), box-shadow 0.28s var(--ease-out-expo);
  }

  .tshow__card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.55;
    transition: opacity 0.28s ease, width 0.28s var(--ease-out-expo);
  }

  .tshow__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--accent) 55%, var(--color-line));
    box-shadow: 0 1.4rem 3rem color-mix(in oklab, var(--accent) 14%, transparent);
  }

  .tshow__card:hover::before {
    opacity: 1;
    width: 4px;
  }

  .tshow__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tshow__num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: color-mix(in oklab, var(--accent) 60%, var(--color-muted));
  }

  .tshow__rail {
    position: absolute;
    inset: auto 1.2rem 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 0.25s ease, transform 0.35s var(--ease-out-expo);
  }

  .tshow__card:hover .tshow__rail {
    opacity: 0.85;
    transform: scaleX(1);
  }

  .tshow__icon {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid color-mix(in oklab, var(--accent) 32%, var(--color-line));
    border-radius: 0.7rem;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
  }

  .tshow__icon :global(.fidic-icon) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .tshow__card strong {
    font-family: var(--font-display);
    font-size: 1.16rem;
    line-height: 1.15;
  }

  .tshow__card p {
    color: var(--color-fg-dim);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .tshow__card em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: color-mix(in oklab, var(--accent) 75%, var(--color-fg));
    transition: transform 0.2s var(--ease-out-expo);
  }

  .tshow__card:hover em {
    transform: translateX(3px);
  }

  @media (min-width: 860px) {
    .tshow__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
