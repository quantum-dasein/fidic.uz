---
import { getBooks } from '../data/books';
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const books = getBooks(lang);
// Books that need dark ink text on their (light) spine/cover.
const lightCovers = ['silver', 'white', 'yellow', 'gold'];
const shelfCopy = {
  ru: {
    preview: 'Живой предпросмотр',
    character: 'Характер книги',
    apply: 'Когда брать с полки',
    risk: 'Риск подрядчика',
    clause: 'Ключевой маркер',
    hint: 'Наведите на корешок, чтобы быстро сравнить характер книги. Нажмите, чтобы открыть полный разворот.',
  },
  en: {
    preview: 'Live preview',
    character: 'Book character',
    apply: 'When to take it off the shelf',
    risk: 'Contractor risk',
    clause: 'Key marker',
    hint: 'Hover a spine to compare the book character. Click to open the full spread.',
  },
  uz: {
    preview: 'Jonli ko‘rish',
    character: 'Kitob xarakteri',
    apply: 'Qachon tanlash kerak',
    risk: 'Pudratchi riski',
    clause: 'Asosiy marker',
    hint: 'Kitobni tez solishtirish uchun muqovaga kursor olib boring. To‘liq ochish uchun bosing.',
  },
}[lang];
---
<section id="suite" class="section relative overflow-hidden">
  <div class="absolute inset-0 bp-grid opacity-40"></div>
  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <!-- Header -->
    <div class="reveal mb-12 max-w-2xl">
      <p class="eyebrow mb-3">{t('suite.eyebrow')}</p>
      <h2 class="font-display font-700 leading-[1.05] tracking-tight text-fg" style="font-size: clamp(2rem, 6.5vw, 3.75rem)">
        {t('suite.h2pre')} <span class="text-brass-gradient">FIDIC</span> {t('suite.h2post')}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-fg-dim">{t('suite.intro')}</p>
    </div>

    <!-- Shelf + spread: one case -->
    <div class="reveal book-case" data-delay="120">
    <div class="book-stage">
      <div class="book-stage__inner">
        <div>
          <div id="fidic-shelf" class="book-shelf flex flex-wrap items-end justify-center gap-2.5 sm:gap-3" role="tablist" aria-label="FIDIC">
            {books.map((b, i) => {
              const light = lightCovers.includes(b.id);
              return (
                <button
                  class="book-spine group relative flex h-36 w-12 shrink-0 cursor-pointer flex-col justify-between overflow-hidden rounded-t-md rounded-b-sm border-b-2 px-2 py-3 sm:h-44 sm:w-14"
                  style={`background: linear-gradient(180deg, ${b.hex}, color-mix(in oklab, ${b.hex} 78%, black)); border-color: color-mix(in oklab, ${b.hex} 60%, black);`}
                  data-book={b.id}
                  data-light={light ? '1' : '0'}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls="book-spread"
                  title={b.name}
                >
                  <span class="font-mono text-[10px] opacity-70" style={`color: ${light ? '#1a1206' : '#fff'};`}>{String(i + 1).padStart(2, '0')}</span>
                  <span
                    class="origin-bottom-left whitespace-nowrap font-display text-sm font-700 tracking-tight"
                    style={`writing-mode: vertical-rl; transform: rotate(180deg); color: ${light ? '#1a1206' : '#fff'};`}
                  >{b.name}</span>
                  <span class="absolute inset-x-0 top-0 h-[3px]" style={`background: color-mix(in oklab, ${b.hex} 40%, white);`}></span>
                </button>
              );
            })}
          </div>
          <p class="mt-3 font-mono text-xs text-muted">{shelfCopy.hint}</p>
        </div>
      </div>
    </div>

    <!-- Open spread -->
    <div id="book-spread" class="book-spread-panel overflow-hidden">
      <div class="grid md:grid-cols-2">
        <!-- LEFT PAGE: identity + risk -->
        <div class="relative border-b border-line p-7 md:border-b-0 md:border-r md:p-10">
          <div id="bk-accent" class="absolute left-0 top-0 h-full w-1.5"></div>
          <div class="flex items-center justify-between gap-4">
            <div>
              <p id="bk-edition" class="eyebrow"></p>
              <h3 id="bk-name" class="mt-2 font-display font-700 text-fg text-[clamp(1.4rem,2.6vw,1.9rem)]"></h3>
              <p id="bk-fullname" class="mt-1 text-sm text-muted"></p>
            </div>
            <div id="bk-swatch" class="h-14 w-14 shrink-0 rounded-lg border border-line"></div>
          </div>

          <p id="bk-oneliner" class="mt-6 font-display text-lg italic leading-snug text-fg"></p>

          <!-- Quick attributes -->
          <div class="mt-7 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line">
            <div class="bg-ink-2 p-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-muted">{t('suite.designs')}</p>
              <p id="bk-designs" class="mt-1 font-600 text-fg"></p>
            </div>
            <div class="bg-ink-2 p-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-muted">{t('suite.pricing')}</p>
              <p id="bk-pricing" class="mt-1 font-600 text-fg"></p>
            </div>
          </div>

          <!-- Risk dial -->
          <div class="mt-7">
            <div class="flex items-center justify-between">
              <p class="font-mono text-[10px] uppercase tracking-widest text-muted">{t('suite.risk')}</p>
              <span id="bk-risk-val" class="font-mono text-sm font-600 text-brass"></span>
            </div>
            <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-ink-3">
              <div id="bk-risk-bar" class="h-full rounded-full transition-all duration-700" style="width:0%"></div>
            </div>
            <div class="mt-1.5 flex justify-between font-mono text-[10px] text-muted">
              <span>{t('suite.riskEmployer')}</span><span>{t('suite.riskBalance')}</span><span>{t('suite.riskContractor')}</span>
            </div>
          </div>
        </div>

        <!-- RIGHT PAGE: facts + signature + UZ -->
        <div class="p-7 md:p-10">
          <p class="font-mono text-[10px] uppercase tracking-widest text-muted">{t('suite.bestFor')}</p>
          <p id="bk-bestfor" class="mt-2 leading-relaxed text-fg-dim"></p>

          <p class="mt-6 font-mono text-[10px] uppercase tracking-widest text-muted">{t('suite.facts')}</p>
          <ul id="bk-facts" class="mt-3 space-y-2.5"></ul>

          <div class="mt-6 rounded-lg border border-line bg-ink p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-brass">{t('suite.clause')}</p>
            <p id="bk-clause" class="mt-1.5 font-mono text-sm text-fg"></p>
          </div>

          <div id="bk-uz-wrap" class="mt-4 rounded-lg border border-brass/30 bg-brass/[0.06] p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-brass">{t('suite.uz')}</p>
            <p id="bk-uz" class="mt-1.5 text-sm leading-relaxed text-fg-dim"></p>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <style>
    /* One case: the shelf and the open spread live inside a single frame. */
    .book-case {
      overflow: hidden;
      border: 1px solid var(--color-line-soft);
      border-radius: 1.15rem;
      box-shadow: 0 2rem 5rem rgba(0,0,0,0.2);
    }

    .book-stage {
      overflow: hidden;
      padding: clamp(0.9rem, 2.2vw, 1.35rem);
      background:
        radial-gradient(circle at 16% 0%, rgba(201,164,92,0.12), transparent 24rem),
        linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012));
    }

    .book-stage__inner {
      display: grid;
      gap: 0.95rem;
      align-items: stretch;
    }

    .book-shelf {
      position: relative;
      align-items: end;
      min-height: 12.75rem;
      padding: 1.25rem 1rem 1.45rem;
      border: 1px solid var(--color-line-soft);
      border-radius: 0.85rem;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0)),
        radial-gradient(circle at 30% 0%, rgba(201,164,92,0.14), transparent 22rem),
        rgba(8, 10, 15, 0.55);
      box-shadow: inset 0 -1.35rem 0 rgba(201,164,92,0.08);
      perspective: 900px;
    }

    .book-spread-panel {
      border-top: 1px solid color-mix(in oklab, var(--color-brass) 34%, var(--color-line));
      background:
        linear-gradient(180deg, rgba(18,22,31,0.98), rgba(8,10,15,0.96)),
        var(--color-ink-2);
    }

    .book-shelf::after {
      content: "";
      position: absolute;
      left: 0.9rem;
      right: 0.9rem;
      bottom: 0.72rem;
      height: 0.45rem;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, rgba(201,164,92,0.42), transparent);
      box-shadow: 0 1rem 2.2rem rgba(0,0,0,0.4);
      pointer-events: none;
    }

    /* Lift is a pure vertical translate (no rotate): the spine grows upward
       and always stays under the cursor, so hovering near an edge can't cause
       the enter/leave flicker the earlier 3D version had. */
    .book-spine {
      transition: transform 260ms var(--ease-out-expo), box-shadow 220ms ease, filter 220ms ease, border-color 220ms ease;
      will-change: transform;
      z-index: 1;
    }

    .book-spine:not([aria-selected="true"]):hover {
      transform: translateY(-8px);
      filter: brightness(1.12) saturate(1.08);
      box-shadow: 0 0 0 1px rgba(255,255,255,0.16), 0 18px 42px -28px rgba(0, 0, 0, 0.8);
    }

    .book-spine[aria-selected="true"] {
      transform: translateY(-14px);
      filter: brightness(1.08) saturate(1.05);
      box-shadow: 0 0 0 1px rgba(255,255,255,0.18), 0 22px 52px -26px rgba(0,0,0,.85);
      z-index: 2;
    }

    @media (prefers-reduced-motion: reduce) {
      .book-spine,
      .book-spine:hover,
      .book-spine[aria-selected="true"] {
        transform: none;
      }
    }

    @media (max-width: 640px) {
      .book-shelf {
        min-height: 11.5rem;
        padding-inline: 0.75rem;
      }
    }
  </style>

  <!-- Book data for the client -->
  <script type="application/json" id="fidic-books-data" set:html={JSON.stringify(books)}></script>

  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('fidic-books-data').textContent);
      var byId = {};
      data.forEach(function (b) { byId[b.id] = b; });

      var el = function (id) { return document.getElementById(id); };
      var selectedId = data[0].id;

      function render(b) {
        el('bk-edition').textContent = b.edition;
        el('bk-name').textContent = b.name;
        el('bk-fullname').textContent = b.fullName;
        el('bk-oneliner').textContent = '«' + b.oneLiner + '»';
        el('bk-designs').textContent = b.whoDesigns;
        el('bk-pricing').textContent = b.pricing;
        el('bk-bestfor').textContent = b.bestFor;
        el('bk-clause').textContent = b.signatureClause;
        el('bk-swatch').style.background = b.hex;
        el('bk-accent').style.background = b.hex;
        el('bk-risk-val').textContent = b.contractorRisk + '%';
        var bar = el('bk-risk-bar');
        bar.style.width = b.contractorRisk + '%';
        bar.style.background = 'linear-gradient(90deg,' + b.hex + ', color-mix(in oklab,' + b.hex + ' 65%, white))';

        var facts = el('bk-facts');
        facts.innerHTML = '';
        b.facts.forEach(function (f) {
          var li = document.createElement('li');
          li.className = 'flex gap-2.5 text-sm leading-relaxed text-fg-dim';
          li.innerHTML = '<span style="color:' + b.hex + '" class="mt-1 shrink-0">▪</span><span>' + f + '</span>';
          facts.appendChild(li);
        });

        var uzWrap = el('bk-uz-wrap');
        if (b.uzbekistan) { uzWrap.style.display = ''; el('bk-uz').textContent = b.uzbekistan; }
        else { uzWrap.style.display = 'none'; }
      }

      // Gentle fade only when the user commits (click); hover updates the
      // spread instantly so scanning across spines can't strobe.
      function flourish() {
        var spread = el('book-spread');
        if (!spread) return;
        spread.style.transition = 'none';
        spread.style.opacity = '0.55';
        requestAnimationFrame(function () {
          spread.style.transition = 'opacity .4s var(--ease-out-expo)';
          spread.style.opacity = '1';
        });
      }

      var spines = document.querySelectorAll('.book-spine');
      function mark(id) {
        spines.forEach(function (s) {
          var on = s.getAttribute('data-book') === id;
          s.setAttribute('aria-selected', on ? 'true' : 'false');
          s.style.borderColor = on ? 'rgba(255,255,255,0.42)' : '';
        });
      }
      function preview(id) { mark(id); render(byId[id]); }
      function select(id) { selectedId = id; mark(id); render(byId[id]); flourish(); }

      spines.forEach(function (s) {
        var id = s.getAttribute('data-book');
        s.addEventListener('click', function () { select(id); });
        s.addEventListener('mouseenter', function () { preview(id); });
        s.addEventListener('mouseleave', function () { preview(selectedId); });
        s.addEventListener('focus', function () { preview(id); });
      });

      select(data[0].id);
    })();
  </script>
</section>
