---
import { type Lang, defaultLang } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;

const copy = {
  ru: {
    eyebrow: 'Mini analytics',
    title: 'Какие инструменты реально открывают',
    text: 'Локальная панель показывает клики в этом браузере. Для GA4 события уже можно отправлять отдельно, а здесь команда видит свой быстрый путь.',
    total: 'Всего кликов',
    top: 'Топ инструмент',
    last: 'Последний клик',
    empty: 'Пока данных нет. Откройте любой инструмент, и панель оживёт.',
    reset: 'Сбросить',
  },
  en: {
    eyebrow: 'Mini analytics',
    title: 'Which tools are actually opened',
    text: 'This local panel shows clicks in this browser. GA4 can collect events separately; here the team sees its own quick path.',
    total: 'Total clicks',
    top: 'Top tool',
    last: 'Last click',
    empty: 'No data yet. Open any tool and the panel will come alive.',
    reset: 'Reset',
  },
  uz: {
    eyebrow: 'Mini analytics',
    title: 'Qaysi vositalar haqiqatan ochilyapti',
    text: 'Bu lokal panel shu brauzerdagi kliklarni ko‘rsatadi. GA4 eventlarni alohida yig‘ishi mumkin, bu yerda esa jamoa o‘z tezkor yo‘lini ko‘radi.',
    total: 'Jami kliklar',
    top: 'Top vosita',
    last: 'So‘nggi klik',
    empty: 'Hali data yo‘q. Biror vositani oching, panel jonlanadi.',
    reset: 'Tozalash',
  },
}[lang];
---

<section class="tool-analytics" data-tool-analytics data-empty={copy.empty}>
  <div>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p>{copy.text}</p>
  </div>
  <div class="tool-analytics__grid">
    <div>
      <span>{copy.total}</span>
      <strong data-tool-analytics-total>0</strong>
    </div>
    <div>
      <span>{copy.top}</span>
      <strong data-tool-analytics-top>—</strong>
    </div>
    <div>
      <span>{copy.last}</span>
      <strong data-tool-analytics-last>—</strong>
    </div>
  </div>
  <div class="tool-analytics__list" data-tool-analytics-list>{copy.empty}</div>
  <button type="button" class="tool-analytics__reset" data-tool-analytics-reset>{copy.reset}</button>
</section>

<style>
  .tool-analytics {
    display: grid;
    gap: 1.2rem;
    margin-bottom: 2.5rem;
    border: 1px solid color-mix(in oklab, var(--color-brass) 28%, var(--color-line));
    border-radius: 1rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    background:
      radial-gradient(circle at 95% 0%, rgba(201,164,92,0.12), transparent 18rem),
      linear-gradient(135deg, rgba(18,22,31,0.82), rgba(8,10,15,0.88));
  }

  .tool-analytics h2 {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.3rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-fg);
  }

  .tool-analytics p:not(.eyebrow) {
    margin-top: 0.55rem;
    max-width: 52rem;
    color: var(--color-fg-dim);
    line-height: 1.6;
  }

  .tool-analytics__grid {
    display: grid;
    gap: 0.75rem;
  }

  .tool-analytics__grid div {
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    padding: 0.9rem;
    background: rgba(255,255,255,0.025);
  }

  .tool-analytics__grid span,
  .tool-analytics__list span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tool-analytics__grid strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-fg);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1;
  }

  .tool-analytics__list {
    display: grid;
    gap: 0.55rem;
    color: var(--color-fg-dim);
    font-size: 0.92rem;
  }

  .tool-analytics__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 0.72rem 0.85rem;
    background: rgba(255,255,255,0.02);
  }

  .tool-analytics__bar {
    grid-column: 1 / -1;
    height: 0.35rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-ink-3);
  }

  .tool-analytics__bar i {
    display: block;
    width: var(--w, 0%);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-brass), var(--color-blueprint));
  }

  .tool-analytics__reset {
    width: fit-content;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.025);
    cursor: pointer;
  }

  .tool-analytics__reset:hover {
    border-color: var(--color-brass);
    color: var(--color-brass-bright);
  }

  @media (min-width: 760px) {
    .tool-analytics__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
