---
import SectionHead from './SectionHead.astro';
import { triageEntries, triageCopy } from '../data/triage';
import { type Lang, defaultLang, localizePath } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = triageCopy[lang];
---

<section id="triage" class="section">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHead
      eyebrow={c.eyebrow}
      title={c.h2}
      sub={c.sub}
      allLabel={c.all}
      allHref={localizePath('/tools', lang)}
    />

    <div class="triage reveal">
      {triageEntries.map((e) => (
        <a class="tri" href={localizePath(e.href, lang)}>
          <span class="tri__mark" aria-hidden="true">{e.mark}</span>
          <span class="tri__q">{e.situation[lang]}</span>
          <span class="tri__a">{e.action[lang]}</span>
        </a>
      ))}
    </div>

    <p class="triage__legend">{c.legend}</p>
  </div>
</section>

<style>
  /* A hairline grid: one border on the container, 1px gaps showing through as
     dividers. Cheaper visually than eight bordered cards and much denser. */
  .triage {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    overflow: hidden;
  }
  @media (min-width: 900px) { .triage { grid-template-columns: 1fr 1fr; } }

  .tri {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.9rem;
    padding: 0.95rem 1.15rem;
    background: var(--color-ink);
    text-decoration: none;
    color: inherit;
    transition: background 0.25s var(--ease-out-expo);
  }
  .tri:hover { background: var(--color-ink-3); }
  .tri:focus-visible {
    outline: none;
    background: var(--color-ink-3);
    box-shadow: inset 0 0 0 2px var(--color-brass);
  }

  .tri__mark {
    grid-row: 1 / span 2;
    align-self: center;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--color-brass) 38%, var(--color-line));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-brass);
  }
  .tri__q {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-fg);
  }
  .tri__a {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-muted);
  }
  .tri:hover .tri__a { color: var(--color-fg-dim); }

  .triage__legend {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
