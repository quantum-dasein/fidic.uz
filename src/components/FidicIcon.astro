  shield: '<path d="M12 3.4 18.2 5.7v5.1c0 4.4-2.5 7.8-6.2 9.8-3.7-2-6.2-5.4-6.2-9.8V5.7L12 3.4Z"/><path d="m8.9 12.1 2 2 4.4-5"/>',
  timeline: '<path d="M5 6h14M5 12h14M5 18h14"/><path d="M8 6v12M16 6v12"/>',
  tools: '<path d="M14.7 5.1a4.1 4.1 0 0 0 4.2 4.2l-8.4 8.4a2.2 2.2 0 0 1-3.1-3.1l8.4-8.4Z"/><path d="m5.4 5.4 4.1 4.1M4.2 4.2l2.4 2.4"/>',
};

const svg = paths[name] ?? paths.book;
---
<svg class:list={['fidic-icon', className]} viewBox="0 0 24 24" fill="none" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <g set:html={svg} />
</svg>

<style>
  .fidic-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: currentColor;
  }

  .fidic-icon :global(path) {
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
</style>
