  map: '<path d="M5 5.8 10 4l4 1.8L19 4v14.2L14 20l-4-1.8L5 20V5.8Z"/><path d="M10 4v14.2M14 5.8V20"/>',
  print: '<path d="M7.2 8V4.2h9.6V8"/><path d="M7.2 16.2H5.7a2 2 0 0 1-2-2v-3.1a2 2 0 0 1 2-2h12.6a2 2 0 0 1 2 2v3.1a2 2 0 0 1-2 2h-1.5"/><path d="M7.2 13.6h9.6v6.2H7.2z"/><path d="M17.1 11.8h.1"/>',
  question: '<path d="M12 20.2a8.2 8.2 0 1 0 0-16.4 8.2 8.2 0 0 0 0 16.4Z"/><path d="M9.7 9.3a2.4 2.4 0 0 1 4.6.9c0 1.9-2.3 2-2.3 3.7"/><path d="M12 16.7h.1"/>',
