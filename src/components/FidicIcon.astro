  claim: '<path d="M7 3.8h7l3 3v11.7a1.7 1.7 0 0 1-1.7 1.7H7a1.7 1.7 0 0 1-1.7-1.7v-13A1.7 1.7 0 0 1 7 3.8Z"/><path d="M13.8 3.8v3.4H17M8.2 11h7.6M8.2 14h7.6M8.2 17h4.4"/>',
