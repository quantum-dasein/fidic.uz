---
// One section header for the whole site.
//
// The markup was already near-identical across sections but duplicated inline,
// so the sizes drifted and there was no single place to tune density. Sections
// now share this, which is what makes a density change a one-line edit rather
// than a ten-file sweep.
interface Props {
  eyebrow: string;
  title: string;
  /** One line of context. Omit where the heading already says everything. */
  sub?: string;
  /** Right-aligned "see all" affordance. */
  allLabel?: string;
  allHref?: string;
  /** Anchor target for in-page navigation. */
  id?: string;
}
const { eyebrow, title, sub, allLabel, allHref, id } = Astro.props;
---

<div class="shead reveal" id={id}>
  <p class="shead__eyebrow">{eyebrow}</p>
  <h2 class="shead__title">{title}</h2>
  {sub && <p class="shead__sub">{sub}</p>}
  {allLabel && allHref && (
    <a href={allHref} class="shead__all link-underline">
      {allLabel}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  )}
</div>

<style>
  .shead {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem 1.5rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }
  @media (min-width: 768px) {
    .shead { grid-template-columns: 1fr auto; }
    /* Keep the "see all" link on the heading's baseline row rather than letting
       it drop below the sub-line. */
    .shead__all { grid-column: 2; grid-row: 2; }
  }

  .shead__eyebrow {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-brass);
  }
  .shead__title {
    grid-column: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .shead__sub {
    grid-column: 1;
    max-width: 46rem;
    color: var(--color-fg-dim);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .shead__all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-brass);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.4rem;
  }
  .shead__all:hover { color: var(--color-brass-bright); }
</style>
