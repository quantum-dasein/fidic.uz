---
// The homepage used to end with two consecutive full-height sections — "Ask
// FIDIC AI" and "Need a review of your contract?" — each with its own eyebrow,
// h2, lead paragraph and form. Two screens asking the visitor to do the same
// thing: type a question and send it. This is that pair merged into one
// section: a single heading, then the two answers side by side — instant and
// free from the assistant, or a human from Bridge Consult about your actual
// contract.
//
// Both anchors are kept: #ask (nav, hero button) on the section, #contact
// (~30 CTAs across the site) on the column with the form.
import { site } from '../data/site';
import { type Lang, defaultLang, useTranslations } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const suggestions = [t('ask.s1'), t('ask.s2'), t('ask.s3'), t('ask.s4')];
const topics = [t('contact.t1'), t('contact.t2'), t('contact.t3'), t('contact.t4'), t('contact.t5')];

const askI18n = {
  you: t('ask.you'),
  errOffline: t('ask.errOffline'),
  errNetwork: t('ask.errNetwork'),
  lang,
};
const leadI18n = {
  email: site.contacts.email,
  sending: t('contact.sending'),
  sent: t('contact.sent'),
  mailto: t('contact.mailto'),
  subject: 'FIDIC.uz',
  fName: t('contact.name'),
  fContact: t('contact.contact'),
  fTopic: t('contact.topic'),
  fMessage: t('contact.message'),
};

const channels = [
  {
    href: site.contacts.telegram,
    external: true,
    label: t('contact.telegram'),
    value: site.contacts.telegramHandle,
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.11.03-1.84 1.18-5.2 3.45-.49.33-.94.5-1.35.49-.45-.01-1.3-.25-1.94-.46z',
    filled: true,
  },
  {
    href: site.contacts.phoneHref,
    external: false,
    label: t('contact.phone'),
    value: site.contacts.phone,
    icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z',
    filled: false,
  },
  {
    href: `mailto:${site.contacts.email}`,
    external: false,
    label: t('contact.email'),
    value: site.contacts.email,
    icon: 'M4 5h16v14H4z M4 7l8 6 8-6',
    filled: false,
  },
];
---
<section id="ask" class="section relative overflow-hidden">
  <div class="absolute inset-0 bp-grid opacity-40"></div>
  <div class="pointer-events-none absolute right-0 top-1/4 h-96 w-96 rounded-full opacity-[0.12] blur-[120px]" style="background: radial-gradient(circle, var(--color-blueprint), transparent 60%)"></div>
  <div class="pointer-events-none absolute -left-32 bottom-0 h-96 w-96 rounded-full opacity-[0.14] blur-[120px]" style="background: radial-gradient(circle, var(--color-brass), transparent 60%)"></div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <!-- Centred is fine on a wide column; on a phone it turns a five-line
         Russian paragraph into a ragged diamond, so left-align below sm. -->
    <div class="reveal mx-auto mb-8 max-w-2xl text-left sm:mb-10 sm:text-center">
      <p class="eyebrow mb-4">{t('contact.eyebrow')}</p>
      <h2 class="font-display text-4xl font-700 leading-[1.05] tracking-tight text-fg md:text-5xl">{t('engage.h2')}</h2>
      <p class="mt-5 text-lg leading-relaxed text-fg-dim">{t('engage.sub')}</p>
    </div>

    <!-- min-w-0: without it the grid track is sized by the prompt row's
         min-content, and a row of non-wrapping chips would stretch the whole
         column past the screen. -->
    <div class="grid items-start gap-6 lg:grid-cols-2 lg:gap-8 [&>*]:min-w-0">
      <!-- Instant: the assistant -->
      <div class="reveal">
        <p class="eyebrow mb-3">{t('ask.eyebrow')}</p>
        <div class="card overflow-hidden p-0">
          <div id="ai-log" class="max-h-[22rem] min-h-[7rem] space-y-4 overflow-y-auto p-5 md:p-6">
            <div class="flex gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brass/40 bg-ink-2 text-brass">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 6.5C7 4.8 9.5 4.8 12 6.2C14.5 4.8 17 4.8 20 6.5V18C17 16.6 14.5 16.6 12 18C9.5 16.6 7 16.6 4 18V6.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              </span>
              <div class="rounded-2xl rounded-tl-sm border border-line bg-ink-2 px-4 py-3 text-sm leading-relaxed text-fg-dim">{t('ask.greeting')}</div>
            </div>
          </div>

          <!-- On a phone the four prompts each wrapped to two centred mono
               lines. Below sm they become a single swipeable row instead. -->
          <div id="ai-suggest" class="ai-suggest flex flex-wrap gap-2 border-t border-line px-5 py-4 md:px-6">
            {suggestions.map((s) => (
              <button class="ai-suggest-btn chip transition-colors hover:border-brass hover:text-brass">{s}</button>
            ))}
          </div>

          <form id="ai-form" class="flex items-center gap-3 border-t border-line p-4 md:px-6">
            <input id="ai-input" type="text" autocomplete="off" placeholder={t('ask.placeholder')} class="min-w-0 flex-1 bg-transparent text-sm text-fg placeholder:text-muted focus:outline-none" />
            <button type="submit" id="ai-send" class="btn btn-primary shrink-0 px-4 py-2.5">
              <span class="hidden sm:inline">{t('ask.send')}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        </div>
        <p class="mt-3 font-mono text-xs text-muted">{t('ask.disclaimer')}</p>
      </div>

      <!-- Human: Bridge Consult -->
      <div id="contact" class="reveal scroll-mt-24" data-delay="120">
        <h3 class="font-display text-2xl font-700 leading-tight tracking-tight text-fg md:text-3xl">{t('contact.h2')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-fg-dim">{t('contact.sub')}</p>

        <form id="lead-form" class="card mt-6 p-5 md:p-6">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="mb-2 block font-mono text-[11px] uppercase tracking-widest text-muted">{t('contact.name')} *</span>
              <input name="name" required class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm text-fg placeholder:text-muted focus:border-brass focus:outline-none" placeholder={t('contact.namePh')} />
            </label>
            <label class="block">
              <span class="mb-2 block font-mono text-[11px] uppercase tracking-widest text-muted">{t('contact.contact')} *</span>
              <input name="contact" required class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm text-fg placeholder:text-muted focus:border-brass focus:outline-none" placeholder="+998 ..." />
            </label>
          </div>
          <label class="mt-4 block">
            <span class="mb-2 block font-mono text-[11px] uppercase tracking-widest text-muted">{t('contact.topic')}</span>
            <select name="topic" class="ff-select w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm text-fg focus:border-brass focus:outline-none">
              {topics.map((opt) => <option>{opt}</option>)}
            </select>
          </label>
          <label class="mt-4 block">
            <span class="mb-2 block font-mono text-[11px] uppercase tracking-widest text-muted">{t('contact.message')}</span>
            <textarea name="message" rows="3" class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm text-fg placeholder:text-muted focus:border-brass focus:outline-none" placeholder={t('contact.messagePh')}></textarea>
          </label>
          <div class="mt-5 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p id="lead-status" class="text-sm text-muted"></p>
            <button type="submit" id="lead-submit" class="btn btn-primary">{t('contact.submit')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </form>

        <ul class="mt-4 grid gap-2 sm:grid-cols-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
                class="group flex items-center gap-2.5 rounded-lg border border-line bg-ink-2/50 px-3 py-2.5 transition-colors hover:border-brass"
              >
                <svg class="h-4 w-4 shrink-0 text-brass" fill={c.filled ? 'currentColor' : 'none'} viewBox="0 0 24 24" aria-hidden="true"><path d={c.icon} stroke={c.filled ? undefined : 'currentColor'} stroke-width={c.filled ? undefined : 1.6}/></svg>
                <span class="min-w-0">
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-muted">{c.label}</span>
                  <span class="block truncate text-xs text-fg-dim transition-colors group-hover:text-brass">{c.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <style>
    @media (max-width: 639px) {
      .ai-suggest {
        flex-wrap: nowrap;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
      }

      .ai-suggest::-webkit-scrollbar {
        display: none;
      }

      .ai-suggest .ai-suggest-btn {
        flex: 0 0 auto;
        max-width: none;
        white-space: nowrap;
        letter-spacing: 0.12em;
      }
    }
  </style>

  <script is:inline define:vars={{ askI18n }}>
    (function () {
      var form = document.getElementById('ai-form');
      var input = document.getElementById('ai-input');
      var log = document.getElementById('ai-log');
      var sendBtn = document.getElementById('ai-send');
      var history = [];

      /*
       * `data-lenis-prevent` tells Lenis to stand aside and let this box scroll
       * natively. That is right once a conversation is long enough to scroll —
       * and wrong before then, which is almost always: the greeting fits, so
       * scrollHeight equals clientHeight and there is nothing to scroll.
       *
       * With the attribute set anyway, the wheel fell through to the browser
       * while the rest of the page is driven by Lenis, so the page scrolled on
       * different physics under this one card. Measured: the same 400px wheel
       * moved the page 400px with the cursor beside the card and 329px over it.
       * Crossing the card's edge switched scroll engines mid-gesture, which is
       * what read as the block lagging.
       *
       * So the attribute follows the overflow instead of being assumed.
       */
      function syncScrollLock() {
        if (!log) return;
        if (log.scrollHeight - log.clientHeight > 4) log.setAttribute('data-lenis-prevent', '');
        else log.removeAttribute('data-lenis-prevent');
      }

      function bubble(role, text) {
        var wrap = document.createElement('div');
        wrap.className = 'flex gap-3' + (role === 'user' ? ' flex-row-reverse' : '');
        var avatar = document.createElement('span');
        avatar.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full border text-xs font-600 ' +
          (role === 'user' ? 'border-line bg-ink-3 text-fg-dim' : 'border-brass/40 bg-ink-2 text-brass');
        avatar.textContent = role === 'user' ? askI18n.you : 'AI';
        var msg = document.createElement('div');
        msg.className = 'max-w-[80%] whitespace-pre-wrap rounded-2xl px-4 py-3 text-sm leading-relaxed ' +
          (role === 'user' ? 'rounded-tr-sm bg-brass/15 text-fg' : 'rounded-tl-sm border border-line bg-ink-2 text-fg-dim');
        msg.textContent = text;
        wrap.appendChild(avatar);
        wrap.appendChild(msg);
        log.appendChild(wrap);
        log.scrollTop = log.scrollHeight;
        syncScrollLock();
        return msg;
      }

      function ask(question) {
        if (!question) return;
        bubble('user', question);
        history.push({ role: 'user', content: question });
        input.value = '';
        sendBtn.disabled = true;
        sendBtn.style.opacity = '0.6';
        var thinking = bubble('assistant', '…');
        var dots = 0;
        var anim = setInterval(function () { dots = (dots + 1) % 4; thinking.textContent = '·'.repeat(dots || 1); }, 350);

        fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history, lang: askI18n.lang }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            clearInterval(anim);
            if (res.ok && res.d && res.d.answer) {
              thinking.textContent = res.d.answer;
              history.push({ role: 'assistant', content: res.d.answer });
            } else {
              thinking.textContent = (res.d && res.d.error) || askI18n.errOffline;
              thinking.className += ' text-fg-dim';
            }
          })
          .catch(function () { clearInterval(anim); thinking.textContent = askI18n.errNetwork; })
          .finally(function () {
            sendBtn.disabled = false;
            sendBtn.style.opacity = '1';
            log.scrollTop = log.scrollHeight;
          });
      }

      syncScrollLock();
      window.addEventListener('resize', syncScrollLock, { passive: true });

      form.addEventListener('submit', function (e) { e.preventDefault(); ask(input.value.trim()); });
      document.querySelectorAll('.ai-suggest-btn').forEach(function (b) {
        b.addEventListener('click', function () { ask(b.textContent.trim()); });
      });
    })();
  </script>

  <script is:inline define:vars={{ leadI18n }}>
    (function () {
      var form = document.getElementById('lead-form');
      var status = document.getElementById('lead-status');
      var btn = document.getElementById('lead-submit');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        var payload = Object.fromEntries(fd.entries());
        btn.disabled = true; btn.style.opacity = '0.6';
        status.textContent = leadI18n.sending;
        status.style.color = 'var(--color-muted)';

        fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function () {
            status.textContent = leadI18n.sent;
            status.style.color = 'var(--color-brass)';
            form.reset();
          })
          .catch(function () {
            var body = encodeURIComponent(
              leadI18n.fName + ': ' + (payload.name || '') + '\n' + leadI18n.fContact + ': ' + (payload.contact || '') +
              '\n' + leadI18n.fTopic + ': ' + (payload.topic || '') + '\n' + leadI18n.fMessage + ': ' + (payload.message || '')
            );
            status.textContent = leadI18n.mailto;
            window.location.href = 'mailto:' + leadI18n.email + '?subject=' + encodeURIComponent(leadI18n.subject) + '&body=' + body;
          })
          .finally(function () { btn.disabled = false; btn.style.opacity = '1'; });
      });
    })();
  </script>
</section>
