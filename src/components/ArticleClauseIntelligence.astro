---
import { clauseRefBySlug } from '../data/clauseReference';
import { type Lang, localizePath } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
}

const { lang, slug, title, description, category, tags } = Astro.props;
const haystack = `${slug} ${title} ${description} ${category} ${tags.join(' ')}`.toLowerCase();

const copy = {
  ru: {
    eyebrow: 'Clause Intelligence',
    title: 'Что связано с этим материалом',
    clauses: 'Связанные пункты',
    deadlines: 'Сроки',
    risks: 'Риски',
    tools: 'Инструменты',
    documents: 'Документы',
    read: 'Открыть',
    noDeadline: 'Срок зависит от текста Particular Conditions и фактов проекта.',
  },
  en: {
    eyebrow: 'Clause Intelligence',
    title: 'What this article connects to',
    clauses: 'Related clauses',
    deadlines: 'Deadlines',
    risks: 'Risks',
    tools: 'Tools',
    documents: 'Documents',
    read: 'Open',
    noDeadline: 'Timing depends on the Particular Conditions and project facts.',
  },
  uz: {
    eyebrow: 'Clause Intelligence',
    title: 'Maqola nimaga bog‘lanadi',
    clauses: 'Bog‘liq bandlar',
    deadlines: 'Muddatlar',
    risks: 'Risklar',
    tools: 'Asboblar',
    documents: 'Hujjatlar',
    read: 'Ochish',
    noDeadline: 'Muddat Particular Conditions va loyiha faktlariga bog‘liq.',
  },
}[lang];

const ruleSets = [
  {
    match: /(20\.2|sub-clause-20|claim|claims|notice|time-bar|28|84|substantiation|records)/,
    clauses: ['claims-20-2', 'notices-1-3', 'agreement-determination-3-7', 'daab-disputes-21'],
    deadlines: {
      ru: ['28 дней: Notice of Claim', '84 дня: fully detailed claim', '28 дней: Notice of Dissatisfaction после DAAB'],
      en: ['28 days: Notice of Claim', '84 days: fully detailed claim', '28 days: Notice of Dissatisfaction after DAAB'],
      uz: ['28 kun: Notice of Claim', '84 kun: batafsil claim', '28 kun: DAABdan keyin Notice of Dissatisfaction'],
    },
    risks: {
      ru: ['time-bar', 'нет contemporary records', 'слабая причинно-следственная связь'],
      en: ['time-bar', 'missing contemporary records', 'weak causation'],
      uz: ['time-bar', 'contemporary records yo‘q', 'sababiy bog‘liqlik zaif'],
    },
    tools: ['notice-deadline', 'claim-readiness', 'claim-file-template', 'calculators/time-bar'],
    docs: ['fidic-claims-playbook', 'claims-email-series'],
  },
  {
    match: /(eot|delay|extension|disruption|prolongation|concurrent|8\.5|8\.8|programme)/,
    clauses: ['extension-of-time-8-5', 'programme-8-3', 'claims-20-2', 'delay-damages-8-8'],
    deadlines: {
      ru: ['28 дней: notice по событию задержки', '84 дня: анализ влияния и расчет', 'обновления программы по Sub-Clause 8.3'],
      en: ['28 days: delay-event notice', '84 days: delay analysis and quantum', 'programme updates under Sub-Clause 8.3'],
      uz: ['28 kun: kechikish hodisasi bo‘yicha notice', '84 kun: delay analysis va quantum', 'Sub-Clause 8.3 bo‘yicha programme update'],
    },
    risks: {
      ru: ['нет baseline/update programme', 'concurrent delay без анализа', 'EOT заявлен как деньги без основания'],
      en: ['no baseline/update programme', 'unanalysed concurrent delay', 'EOT treated as money without basis'],
      uz: ['baseline/update programme yo‘q', 'concurrent delay tahlilsiz', 'EOT pul talabi bilan aralashgan'],
    },
    tools: ['calculators/eot-delay', 'calculators/time-bar', 'notice-deadline', 'claim-readiness'],
    docs: ['fidic-claims-playbook', 'claim-checklist'],
  },
  {
    match: /(daab|dab|dispute|arbitration|nod|dissatisfaction|21)/,
    clauses: ['daab-disputes-21', 'agreement-determination-3-7', 'claims-20-2', 'notices-1-3'],
    deadlines: {
      ru: ['84 дня: типовой срок решения DAAB', '28 дней: Notice of Dissatisfaction', 'amicable settlement до арбитража'],
      en: ['84 days: typical DAAB decision period', '28 days: Notice of Dissatisfaction', 'amicable settlement before arbitration'],
      uz: ['84 kun: DAAB qarori uchun odatiy muddat', '28 kun: Notice of Dissatisfaction', 'arbitrajdan oldin amicable settlement'],
    },
    risks: {
      ru: ['DAAB не назначен заранее', 'пропущен NOD', 'позиция без record file'],
      en: ['DAAB not appointed early', 'missed NOD', 'position without record file'],
      uz: ['DAAB oldindan tayinlanmagan', 'NOD o‘tkazib yuborilgan', 'record filesiz pozitsiya'],
    },
    tools: ['calculators/daab-timeline', 'claim-readiness', 'claim-file-template'],
    docs: ['fidic-claims-playbook'],
  },
  {
    match: /(mdb|world bank|adb|ebrd|pink|procurement|tender|public procurement|kazakhstan|uzbekistan|fidic uzbekistan|fidic kazakhstan)/,
    clauses: ['performance-security-4-2', 'claims-20-2', 'payment-14', 'daab-disputes-21'],
    deadlines: {
      ru: ['до подачи: clarifications по tender package', 'после award: сверка Contract Data / COPA', 'в проекте: 28/84 по claims'],
      en: ['before submission: tender-package clarifications', 'after award: Contract Data / COPA check', 'during project: 28/84 claims cycle'],
      uz: ['submissiongacha: tender package clarifications', 'awarddan keyin: Contract Data / COPA tekshiruvi', 'loyihada: 28/84 claims cycle'],
    },
    risks: {
      ru: ['несовместимость local law и FIDIC', 'банковские integrity/audit условия', 'неясные Particular Conditions'],
      en: ['local law and FIDIC mismatch', 'bank integrity/audit conditions', 'unclear Particular Conditions'],
      uz: ['local law va FIDIC mos emas', 'bank integrity/audit shartlari', 'noaniq Particular Conditions'],
    },
    tools: ['tender-risk-lab', 'tender-clarification-generator', 'contract-risk-score', 'book-selector'],
    docs: ['mdb-project-cases', 'fidic-claims-playbook'],
  },
  {
    match: /(red|yellow|silver|rainbow|book|books|suite|epc|design-build|turnkey)/,
    clauses: ['contractor-design-5', 'measurement-12', 'unforeseeable-conditions-4-12', 'claims-20-2'],
    deadlines: {
      ru: ['до tender: выбор книги и risk allocation', 'до подписания: Contract Data / Particular Conditions', 'в проекте: notice discipline'],
      en: ['before tender: book choice and risk allocation', 'before signing: Contract Data / Particular Conditions', 'during project: notice discipline'],
      uz: ['tenderdan oldin: kitob tanlovi va risk allocation', 'imzolashdan oldin: Contract Data / Particular Conditions', 'loyihada: notice discipline'],
    },
    risks: {
      ru: ['не та книга под delivery model', 'design risk перенесен молча', 'price certainty против фактических данных'],
      en: ['wrong book for delivery model', 'silent transfer of design risk', 'price certainty against poor site data'],
      uz: ['delivery model uchun noto‘g‘ri kitob', 'design risk yashirin o‘tgan', 'price certainty va yomon site data ziddiyati'],
    },
    tools: ['book-selector', 'book-comparison', 'tender-risk-lab'],
    docs: ['rainbow-guide', 'editions-1999-2017-2022'],
  },
];

const eotRule = ruleSets.find((entry) => /(eot|delay|extension|disruption|prolongation|concurrent|8\.5|8\.8|programme)/.test(String(entry.match)));
const isEotTopic = /(eot|delay|extension|disruption|prolongation|concurrent|8\.5|8\.8|programme)/.test(haystack);
const rule = (isEotTopic && eotRule?.match.test(haystack) ? eotRule : undefined) ?? ruleSets.find((entry) => entry.match.test(haystack)) ?? ruleSets[0];
const clauses = rule.clauses.map((clauseSlug) => clauseRefBySlug(clauseSlug)).filter(Boolean);

const toolLabels: Record<string, Record<Lang, string>> = {
  'notice-deadline': { ru: 'Notice Deadline', en: 'Notice Deadline', uz: 'Notice Deadline' },
  'claim-readiness': { ru: 'Claim Readiness', en: 'Claim Readiness', uz: 'Claim Readiness' },
  'claim-file-template': { ru: 'Claim File Template', en: 'Claim File Template', uz: 'Claim File Template' },
  'calculators/time-bar': { ru: 'Time-bar калькулятор', en: 'Time-bar calculator', uz: 'Time-bar kalkulyator' },
  'calculators/eot-delay': { ru: 'EOT Delay', en: 'EOT Delay', uz: 'EOT Delay' },
  'calculators/daab-timeline': { ru: 'DAAB Timeline', en: 'DAAB Timeline', uz: 'DAAB Timeline' },
  'tender-risk-lab': { ru: 'Tender Risk Lab', en: 'Tender Risk Lab', uz: 'Tender Risk Lab' },
  'tender-clarification-generator': { ru: 'Clarification Generator', en: 'Clarification Generator', uz: 'Clarification Generator' },
  'contract-risk-score': { ru: 'Contract Risk Score', en: 'Contract Risk Score', uz: 'Contract Risk Score' },
  'book-selector': { ru: 'Book Selector', en: 'Book Selector', uz: 'Book Selector' },
  'book-comparison': { ru: 'Red vs Yellow vs Silver', en: 'Red vs Yellow vs Silver', uz: 'Red vs Yellow vs Silver' },
};

const docLabels: Record<string, Record<Lang, string>> = {
  'fidic-claims-playbook': { ru: 'FIDIC Claims Playbook', en: 'FIDIC Claims Playbook', uz: 'FIDIC Claims Playbook' },
  'claims-email-series': { ru: '5 писем про claims', en: '5-email claims course', uz: 'Claims bo‘yicha 5 xat' },
  'claim-checklist': { ru: 'Чеклист claim', en: 'Claim checklist', uz: 'Claim checklist' },
  'mdb-project-cases': { ru: 'Кейсы проектов МФО', en: 'MDB project cases', uz: 'MDB project cases' },
  'rainbow-guide': { ru: 'Радужная серия FIDIC', en: 'FIDIC Rainbow Guide', uz: 'FIDIC Rainbow Guide' },
  'editions-1999-2017-2022': { ru: 'Редакции 1999 / 2017 / 2022', en: 'Editions 1999 / 2017 / 2022', uz: '1999 / 2017 / 2022 nashrlari' },
};

const docHref = (doc: string) => {
  if (doc === 'rainbow-guide' || doc === 'editions-1999-2017-2022') return localizePath(`/knowledge/${doc}`, lang);
  if (doc === 'mdb-project-cases') return localizePath('/mdb-project-cases', lang);
  return localizePath(`/resources/${doc}`, lang);
};
---

<aside class="clause-intel" aria-label={copy.title}>
  <div class="clause-intel__head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
  </div>

  <div class="clause-intel__grid">
    <section class="clause-intel__panel">
      <h3>{copy.clauses}</h3>
      <div class="clause-intel__links">
        {clauses.map((clause) => clause && (
          <a href={localizePath(`/clauses/${clause.slug}`, lang)}>
            <span>{clause.number}</span>
            <strong>{clause.title[lang]}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="clause-intel__panel">
      <h3>{copy.deadlines}</h3>
      <ul>
        {(rule.deadlines[lang] ?? [copy.noDeadline]).map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="clause-intel__panel">
      <h3>{copy.risks}</h3>
      <ul>
        {rule.risks[lang].map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="clause-intel__panel">
      <h3>{copy.tools}</h3>
      <div class="clause-intel__chips">
        {rule.tools.map((tool) => (
          <a href={localizePath(`/tools/${tool}`, lang)}>{toolLabels[tool]?.[lang] ?? tool}</a>
        ))}
      </div>
      <h3 class="clause-intel__documents">{copy.documents}</h3>
      <div class="clause-intel__chips">
        {rule.docs.map((doc) => (
          <a href={docHref(doc)}>{docLabels[doc]?.[lang] ?? doc}</a>
        ))}
      </div>
    </section>
  </div>
</aside>

<style>
  .clause-intel {
    margin-top: 3rem;
    border: 1px solid color-mix(in oklab, var(--color-brass) 38%, var(--color-line));
    border-radius: 1.15rem;
    padding: 1.25rem;
    background:
      linear-gradient(135deg, rgba(218, 172, 83, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018));
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.22);
  }

  .clause-intel__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .clause-intel h2 {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-fg);
  }

  .clause-intel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .clause-intel__panel {
    border: 1px solid color-mix(in oklab, var(--color-line) 74%, transparent);
    border-radius: 0.9rem;
    padding: 1rem;
    background: rgba(4, 8, 14, 0.45);
  }

  .clause-intel__panel h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-brass);
  }

  .clause-intel__links,
  .clause-intel__chips {
    display: grid;
    gap: 0.55rem;
  }

  .clause-intel__links a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    color: var(--color-fg);
    text-decoration: none;
  }

  .clause-intel__links span {
    min-width: 2.6rem;
    border-radius: 999px;
    padding: 0.2rem 0.45rem;
    background: rgba(218, 172, 83, 0.12);
    color: var(--color-brass);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .clause-intel__links strong {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .clause-intel__panel ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.05rem;
    color: var(--color-fg-dim);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .clause-intel__chips {
    display: flex;
    flex-wrap: wrap;
  }

  .clause-intel__chips a {
    border: 1px solid color-mix(in oklab, var(--color-line) 72%, transparent);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    color: var(--color-fg);
    font-size: 0.82rem;
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out-expo), color 0.2s var(--ease-out-expo);
  }

  .clause-intel__chips a:hover {
    border-color: var(--color-brass);
    color: var(--color-brass);
  }

  .clause-intel__documents {
    margin-top: 1rem !important;
  }

  @media (max-width: 760px) {
    .clause-intel__head,
    .clause-intel__grid {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
