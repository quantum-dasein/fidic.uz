---
import { site, nav } from '../data/site';
import FidicIcon from './FidicIcon.astro';
import { type Lang, defaultLang, useTranslations, localizePath } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const home = localizePath('/', lang);
const navIconByKey: Record<string, string> = {
  'nav.suite': 'book',
  'nav.knowledge': 'book',
  'nav.tools': 'tools',
  'nav.glossary': 'question',
  'nav.certification': 'shield',
  'nav.ask': 'contact',
};

const navItems = nav.map((n) => ({ label: t(n.key), href: localizePath(n.href, lang), icon: navIconByKey[n.key] ?? 'book', key: n.key }));
const sectionLinks = [
  ...navItems.filter((item) => item.key !== 'nav.tools'),
  { href: '/verify/', icon: 'shield', label: lang === 'uz' ? 'Sertifikatni tekshirish' : lang === 'en' ? 'Verify a certificate' : 'Проверить сертификат' },
];
const workTitle = lang === 'uz' ? 'Vositalar' : lang === 'en' ? 'Tools' : 'Инструменты';
const workLinks = [
  { href: localizePath('/tools', lang), icon: 'tools', label: lang === 'uz' ? 'Barcha vositalar' : lang === 'en' ? 'All tools' : 'Все инструменты' },
  { href: localizePath('/resources', lang), icon: 'claim', label: lang === 'uz' ? 'Bepul materiallar' : lang === 'en' ? 'Free resources' : 'Бесплатные материалы' },
  { href: localizePath('/tools/calculators', lang), icon: 'calculator', label: lang === 'uz' ? 'FIDIC kalkulyatorlari' : lang === 'en' ? 'FIDIC calculators' : 'FIDIC калькуляторы' },
  { href: localizePath('/tools/contract-risk-score', lang), icon: 'risk', label: 'Contract Risk Score' },
  { href: localizePath('/resources/claim-checklist', lang), icon: 'timeline', label: lang === 'uz' ? 'Claim cheklisti' : lang === 'en' ? 'Claim checklist' : 'Чеклист claim' },
  { href: localizePath('/resources/fidic-claims-playbook', lang), icon: 'claim', label: 'FIDIC Claims Playbook' },
];
---
<footer class="site-footer relative overflow-hidden border-t border-line bg-ink-2/40">
  <div class="site-footer__grid" aria-hidden="true"></div>
  <div class="site-footer__rail" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-5 py-12 md:px-8">
    <div class="site-footer__layout">
      <div class="site-footer__brand">
        <a href={home} class="footer-logo inline-flex items-center gap-3">
          <span class="footer-logo__mark flex h-10 w-10 items-center justify-center rounded-md border border-brass/35 bg-ink">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6.5C7 4.8 9.5 4.8 12 6.2C14.5 4.8 17 4.8 20 6.5V18C17 16.6 14.5 16.6 12 18C9.5 16.6 7 16.6 4 18V6.5Z" stroke="var(--color-brass)" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M12 6.2V18" stroke="var(--color-brass)" stroke-width="1.4"/>
            </svg>
          </span>
          <span class="font-display text-2xl font-700 tracking-tight text-fg">FIDIC<span class="text-brass">.uz</span></span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">{t('footer.about')}</p>
        <p class="mt-6 text-xs uppercase tracking-[0.25em] text-muted">{t('footer.poweredBy')}</p>
        <a href={site.poweredByUrl} target="_blank" rel="noopener" class="footer-link link-underline mt-1 inline-block font-display text-lg text-brass">{site.poweredBy}</a>
      </div>

      <div class="site-footer__panel">
        <p class="eyebrow mb-4">{t('footer.sections')}</p>
        <ul class="site-footer__links">
          {sectionLinks.map((item) => (
            <li><a href={item.href} class="footer-link footer-link--icon"><FidicIcon name={item.icon} />{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__panel">
        <p class="eyebrow mb-4">{workTitle}</p>
        <ul class="site-footer__links">
          {workLinks.map((item) => (
            <li><a href={item.href} class="footer-link footer-link--icon"><FidicIcon name={item.icon} />{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__panel">
        <p class="eyebrow mb-4">{t('footer.contacts')}</p>
        <ul class="site-footer__links">
          <li><a href={site.contacts.phoneHref} class="footer-link footer-link--icon"><FidicIcon name="contact" />{site.contacts.phone}</a></li>
          <li><a href={`mailto:${site.contacts.email}`} class="footer-link footer-link--icon"><FidicIcon name="contact" />{site.contacts.email}</a></li>
          <li><a href={site.contacts.telegram} target="_blank" rel="noopener" class="footer-link footer-link--icon"><FidicIcon name="contact" />Telegram {site.contacts.telegramHandle}</a></li>
          <li class="footer-address pt-1 text-muted"><FidicIcon name="map" /><span>{lang === 'uz' ? site.contacts.addressUz : lang === 'en' ? site.contacts.addressEn : site.contacts.address}</span></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 text-xs text-muted md:flex-row md:items-center">
      <p>© {year} FIDIC.uz — {t('footer.project')} {site.poweredBy}. {t('footer.rights')}</p>
      <p class="font-mono">{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer__layout {
    display: grid;
    gap: 2.4rem;
  }

  .site-footer__links {
    display: grid;
    gap: 0.72rem;
    min-width: 0;
  }

  .footer-link--icon,
  .footer-address {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--color-fg-dim);
    font-size: 0.92rem;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .footer-link--icon:hover {
    color: var(--color-brass);
  }

  .footer-link--icon :global(.fidic-icon),
  .footer-address :global(.fidic-icon) {
    width: 1rem;
    height: 1rem;
    margin-top: 0.08rem;
    flex: 0 0 auto;
    color: var(--color-brass);
  }

  @media (min-width: 760px) {
    .site-footer__layout {
      grid-template-columns: minmax(0, 1.25fr) minmax(11rem, 0.72fr) minmax(12rem, 0.84fr) minmax(13rem, 0.9fr);
      align-items: start;
    }
  }

  @media (max-width: 759px) {
    .site-footer__layout {
      gap: 2rem;
    }
  }
</style>
