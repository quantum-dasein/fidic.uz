---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import Marquee from '../Marquee.astro';
import TriagePanel from '../TriagePanel.astro';
import TendersTeaser from '../TendersTeaser.astro';
import SectionHead from '../SectionHead.astro';
import Pillars from '../Pillars.astro';
import RainbowBook from '../RainbowBook.astro';
import BookComparison from '../BookComparison.astro';
import MdbCasesTeaser from '../MdbCasesTeaser.astro';
import DisputeLadder from '../DisputeLadder.astro';
import ContractClauseMap from '../ContractClauseMap.astro';
import CertificationTeaser from '../CertificationTeaser.astro';
import ToolsShowcase from '../ToolsShowcase.astro';
import Faq from '../Faq.astro';
import AskAI from '../AskAI.astro';
import Contact from '../Contact.astro';
import ArticleCard from '../ArticleCard.astro';
import { site } from '../../data/site';
import { type Lang, defaultLang, useTranslations, localizePath, categoryLabel } from '../../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('articles');
// "Freshest" means last substantively revised, not first published — a rewritten
// cornerstone page should surface here (and get the homepage inlink) too.
const freshness = (a: (typeof all)[number]) => (a.data.updated ?? a.data.date).getTime();
const articles = all
  .filter((a) => a.id.startsWith(`${lang}/`))
  .sort((a, b) => freshness(b) - freshness(a))
  .slice(0, 3);
const slugOf = (id: string) => id.slice(lang.length + 1);
const knowledgeHref = localizePath('/knowledge', lang);
---
<Layout noHeaderOffset lang={lang} title={t('home.title')} description={t('footer.about')}>
  <Hero lang={lang} />
  <Marquee />
  <TriagePanel lang={lang} />
  <Pillars lang={lang} />
  <RainbowBook lang={lang} />
  <BookComparison lang={lang} />
  <MdbCasesTeaser lang={lang} />
  <ContractClauseMap lang={lang} />
  <DisputeLadder lang={lang} />

  {articles.length > 0 && (
    <section id="knowledge" class="section relative">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <SectionHead
          eyebrow={t('knowledge.eyebrow')}
          title={t('knowledge.fresh')}
          allLabel={t('knowledge.all')}
          allHref={knowledgeHref}
        />
        <div class="grid gap-4 md:grid-cols-3">
          {articles.map((a, i) => (
            <ArticleCard
              href={localizePath(`/knowledge/${slugOf(a.id)}`, lang)}
              title={a.data.title}
              description={a.data.description}
              category={categoryLabel(a.data.category, lang)}
              date={a.data.date}
              readingTime={a.data.readingTime}
              delay={i * 90}
              lang={lang}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <TendersTeaser lang={lang} />
  <CertificationTeaser lang={lang} />
  <ToolsShowcase lang={lang} />
  <Faq lang={lang} />
  <AskAI lang={lang} />
  <Contact lang={lang} />
</Layout>
