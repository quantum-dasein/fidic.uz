---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../ArticleCard.astro';
import ContractClauseMap from '../ContractClauseMap.astro';
import { site } from '../../data/site';
import { categoryPages } from '../../data/categoryPages';
import { type Lang, defaultLang, useTranslations, localizePath, dateLocale, categoryLabel } from '../../i18n/ui';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const slugOf = (id: string) => id.slice(lang.length + 1);
const articles = (await getCollection('articles'))
  .filter((a) => a.id.startsWith(`${lang}/`))
  .sort((a, b) => (b.data.updated ?? b.data.date).getTime() - (a.data.updated ?? a.data.date).getTime());

const catKeys = [...new Set(articles.map((a) => a.data.category))];
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const dateStr = featured
  ? new Intl.DateTimeFormat(dateLocale(lang), { day: 'numeric', month: 'long', year: 'numeric' }).format(featured.data.date)
  : '';
const rest = featured ? articles.filter((a) => a.id !== featured.id) : [];

// Topic hubs: counts come from the same collection so the index cannot claim
// a section has articles it does not.
const countByCategory = new Map();
for (const a of articles) countByCategory.set(a.data.category, (countByCategory.get(a.data.category) ?? 0) + 1);
const catCopy = {
  ru: { title: 'Разделы базы знаний', count: 'материалов' },
  en: { title: 'Knowledge base sections', count: 'articles' },
  uz: { title: 'Bilimlar bazasi boʻlimlari', count: 'material' },
}[lang];

const copy = {
  ru: {
    searchLabel: 'Поиск по Knowledge Hub',
    searchPlaceholder: 'Найдите: EOT, DAAB, Silver Book, ADB, 28 дней...',
    navigatorEyebrow: 'Навигатор',
    navigatorTitle: 'Маршруты по темам',
    navigatorSub: 'Выберите практический маршрут: сайт покажет материалы, которые относятся к одной задаче, а не просто к одной категории.',
    allClusters: 'Все маршруты',
    results: 'материалов найдено',
    empty: 'Ничего не найдено. Попробуйте другой термин или сбросьте фильтр.',
    clusters: [
      { id: 'claims', title: 'Claims & Notices', desc: 'Уведомления, substantiation, 28 дней, records, стоимость и процедура.', terms: ['claim', 'claims', 'notice', '28', 'substantiation', 'records', 'prolongation', 'concurrent', 'disruption'] },
      { id: 'delay', title: 'Delay / EOT', desc: 'Extension of Time, delay analysis, disruption and concurrent delay.', terms: ['delay', 'eot', 'extension', 'disruption', 'concurrent', 'prolongation'] },
      { id: 'mdb', title: 'MDB Procurement', desc: 'World Bank, ADB, Pink Book, Contract Data and tender strategy.', terms: ['world bank', 'adb', 'mdb', 'pink', 'procurement', 'tender', 'merit', 'contract data', 'section viii'] },
      { id: 'fidic-books', title: 'FIDIC Books', desc: 'Rainbow Series, Red/Yellow/Silver/Green/Emerald Book and editions.', terms: ['rainbow', 'book', 'silver', 'green', 'emerald', 'red', 'yellow', '2022', '1999', '2017'] },
      { id: 'daab', title: 'DAAB & Disputes', desc: 'DAAB, decisions, site visits and dispute escalation.', terms: ['daab', 'dispute', 'arbitration', 'site visits'] },
      { id: 'payment-security', title: 'Payment & Securities', desc: 'Clause 14, IPC, guarantees, retention and performance security.', terms: ['payment', 'clause 14', 'ipc', 'security', 'securities', 'guarantee', 'retention', 'performance security'] },
    ],
  },
  en: {
    searchLabel: 'Search Knowledge Hub',
    searchPlaceholder: 'Search: EOT, DAAB, Silver Book, ADB, 28 days...',
    navigatorEyebrow: 'Navigator',
    navigatorTitle: 'Topic pathways',
    navigatorSub: 'Choose a practical pathway: the hub groups materials by the task behind the search intent.',
    allClusters: 'All pathways',
    results: 'materials found',
    empty: 'No materials found. Try another term or reset filters.',
    clusters: [
      { id: 'claims', title: 'Claims & Notices', desc: 'Notices, substantiation, 28 days, records, cost and procedure.', terms: ['claim', 'claims', 'notice', '28', 'substantiation', 'records', 'prolongation', 'concurrent', 'disruption'] },
      { id: 'delay', title: 'Delay / EOT', desc: 'Extension of Time, delay analysis, disruption and concurrent delay.', terms: ['delay', 'eot', 'extension', 'disruption', 'concurrent', 'prolongation'] },
      { id: 'mdb', title: 'MDB Procurement', desc: 'World Bank, ADB, Pink Book, Contract Data and tender strategy.', terms: ['world bank', 'adb', 'mdb', 'pink', 'procurement', 'tender', 'merit', 'contract data', 'section viii'] },
      { id: 'fidic-books', title: 'FIDIC Books', desc: 'Rainbow Series, Red/Yellow/Silver/Green/Emerald Book and editions.', terms: ['rainbow', 'book', 'silver', 'green', 'emerald', 'red', 'yellow', '2022', '1999', '2017'] },
      { id: 'daab', title: 'DAAB & Disputes', desc: 'DAAB, decisions, site visits and dispute escalation.', terms: ['daab', 'dispute', 'arbitration', 'site visits'] },
      { id: 'payment-security', title: 'Payment & Securities', desc: 'Clause 14, IPC, guarantees, retention and performance security.', terms: ['payment', 'clause 14', 'ipc', 'security', 'securities', 'guarantee', 'retention', 'performance security'] },
    ],
  },
  uz: {
    searchLabel: 'Knowledge Hub bo‘yicha qidiruv',
    searchPlaceholder: 'Qidiring: EOT, DAAB, Silver Book, ADB, 28 kun...',
    navigatorEyebrow: 'Navigator',
    navigatorTitle: 'Mavzular bo‘yicha yo‘nalishlar',
    navigatorSub: 'Amaliy yo‘nalishni tanlang: materiallar oddiy kategoriya emas, real vazifa bo‘yicha guruhlanadi.',
    allClusters: 'Barcha yo‘nalishlar',
    results: 'material topildi',
    empty: 'Material topilmadi. Boshqa so‘z kiriting yoki filterni tozalang.',
    clusters: [
      { id: 'claims', title: 'Claims & Notices', desc: 'Notices, substantiation, 28 kun, records, xarajat va tartib.', terms: ['claim', 'claims', 'notice', '28', 'substantiation', 'records', 'prolongation', 'concurrent', 'disruption'] },
      { id: 'delay', title: 'Delay / EOT', desc: 'Extension of Time, delay analysis, disruption va concurrent delay.', terms: ['delay', 'eot', 'extension', 'disruption', 'concurrent', 'prolongation'] },
      { id: 'mdb', title: 'MDB Procurement', desc: 'World Bank, ADB, Pink Book, Contract Data va tender strategy.', terms: ['world bank', 'adb', 'mdb', 'pink', 'procurement', 'tender', 'merit', 'contract data', 'section viii'] },
      { id: 'fidic-books', title: 'FIDIC Books', desc: 'Rainbow Series, Red/Yellow/Silver/Green/Emerald Book va nashrlar.', terms: ['rainbow', 'book', 'silver', 'green', 'emerald', 'red', 'yellow', '2022', '1999', '2017'] },
      { id: 'daab', title: 'DAAB & Disputes', desc: 'DAAB, decisions, site visits va nizolar eskalatsiyasi.', terms: ['daab', 'dispute', 'arbitration', 'site visits'] },
      { id: 'payment-security', title: 'Payment & Securities', desc: 'Clause 14, IPC, guarantees, retention va performance security.', terms: ['payment', 'clause 14', 'ipc', 'security', 'securities', 'guarantee', 'retention', 'performance security'] },
    ],
  },
}[lang];

const normalize = (value: string) => value.toLowerCase();
const articleSearch = (a: (typeof articles)[number]) => normalize([
  a.data.title,
  a.data.description,
  a.data.category,
  ...a.data.tags,
  slugOf(a.id).replaceAll('-', ' '),
].join(' '));
const clustersFor = (a: (typeof articles)[number]) => {
  const haystack = articleSearch(a);
  return copy.clusters.filter((cluster) => cluster.terms.some((term) => haystack.includes(term))).map((cluster) => cluster.id);
};

const pageUrl = `${site.url}${localizePath('/knowledge', lang)}`;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('kn.h1'),
  description: t('kn.sub'),
  url: pageUrl,
  inLanguage: lang,
  isPartOf: { '@id': `${site.url}/#website` },
  about: copy.clusters.map((cluster) => cluster.title),
  mainEntity: {
    '@type': 'ItemList',
    name: copy.navigatorTitle,
    itemListElement: copy.clusters.map((cluster, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: cluster.title,
      description: cluster.desc,
    })),
  },
};
---
<Layout title={`${t('kn.h1')} | ${site.name}`} description={t('kn.desc')} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <section class="relative">
    <div class="absolute inset-0 bp-grid opacity-40"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow mb-4">{t('kn.eyebrow')}</p>
      <h1 class="max-w-3xl font-display font-700 leading-[1.05] tracking-tight text-fg" style="font-size: clamp(1.9rem, 6.5vw, 3.75rem)">{t('kn.h1')}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-fg-dim">{t('kn.sub')}</p>

      <div class="kn-hub">
        {[
          ['/clauses', lang === 'uz' ? 'Bandlar maʼlumotnomasi' : lang === 'en' ? 'Clause reference' : 'Справочник пунктов', lang === 'uz' ? '28 ta asosiy FIDIC bandi sodda tilda' : lang === 'en' ? '28 key FIDIC clauses in plain language' : '28 ключевых пунктов FIDIC простым языком'],
          ['/knowledge/editions-1999-2017-2022', lang === 'uz' ? 'Nashrlar: 1999 → 2017 → 2022' : lang === 'en' ? 'Editions: 1999 → 2017 → 2022' : 'Редакции: 1999 → 2017 → 2022', lang === 'uz' ? 'Nashrlar orasidagi band-band farqlar' : lang === 'en' ? 'Clause-by-clause differences between editions' : 'Постатейная разница между изданиями'],
          ['/knowledge/fidic-and-uzbek-law', lang === 'uz' ? 'FIDIC va Oʻzbekiston huquqi' : lang === 'en' ? 'FIDIC and Uzbek law' : 'FIDIC и право Узбекистана', lang === 'uz' ? 'Standartni mahalliy huquq bilan moslashtirish' : lang === 'en' ? 'Reconciling the standard with local law' : 'Как свести стандарт с местным правом'],
          ['/glossary', lang === 'uz' ? 'Lugʻat' : lang === 'en' ? 'Glossary' : 'Глоссарий', lang === 'uz' ? 'FIDIC atamalari sodda tilda' : lang === 'en' ? 'FIDIC terms in plain language' : 'Термины FIDIC простым языком'],
        ].map(([href, title, desc]) => (
          <a href={localizePath(href, lang)} class="kn-hub__card">
            <strong>{title}</strong>
            <span>{desc}</span>
            <em>→</em>
          </a>
        ))}
      </div>

      <p class="kn-cats__title">{catCopy.title}</p>
      <div class="kn-cats">
        {categoryPages.map((c) => (
          <a href={localizePath(`/knowledge/${c.key}`, lang)} class="kn-cats__link">
            <strong>{c.title[lang]}</strong>
            <span>{countByCategory.get(c.key) ?? 0} {catCopy.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {!featured && (
    <section class="mx-auto max-w-7xl px-5 py-24 text-center md:px-8">
      <p class="text-lg text-muted">{t('kn.empty')}</p>
    </section>
  )}

  {featured && (
    <section class="mx-auto max-w-7xl px-5 pt-4 md:px-8 md:pt-2">
      <a href={localizePath(`/knowledge/${slugOf(featured.id)}`, lang)} class="card group block overflow-hidden p-7 md:p-10">
        <div class="flex items-center gap-3">
          <span class="font-mono text-[11px] uppercase tracking-widest text-brass">{categoryLabel(featured.data.category, lang)}</span>
          <span class="h-1 w-1 rounded-full bg-muted"></span>
          <span class="font-mono text-xs text-muted">{t('kn.featured')}</span>
        </div>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-700 leading-tight text-fg transition-colors group-hover:text-brass-bright md:text-4xl">{featured.data.title}</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-fg-dim">{featured.data.description}</p>
        <div class="mt-6 flex items-center gap-4 text-sm text-muted">
          <span>{dateStr}</span><span>·</span><span>{featured.data.readingTime} {t('card.minRead')}</span>
        </div>
      </a>
    </section>
  )}

  <ContractClauseMap lang={lang} compact />

  {rest.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 py-14 md:px-8">
      <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div>
          <label for="knowledge-search" class="eyebrow mb-3 block">{copy.searchLabel}</label>
          <div class="knowledge-search flex items-center gap-3 rounded-full border border-line bg-ink-2/70 px-4 py-3">
            <svg class="shrink-0 text-brass" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 19a8 8 0 1 1 5.3-14A8 8 0 0 1 11 19Zm6-2 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input id="knowledge-search" type="search" placeholder={copy.searchPlaceholder} class="min-w-0 flex-1 bg-transparent text-sm text-fg placeholder:text-muted focus:outline-none" />
          </div>
        </div>
        <p class="font-mono text-xs text-muted"><span id="knowledge-count">{rest.length}</span> {copy.results}</p>
      </div>

      <div class="kn-navigator mb-10 rounded-2xl border border-line bg-ink-2/40 p-5 md:p-6">
        <div class="kn-navigator__head mb-5 flex flex-col justify-between gap-3 md:flex-row md:items-end">
          <div>
            <p class="eyebrow mb-2">{copy.navigatorEyebrow}</p>
            <h2 class="font-display text-2xl font-700 text-fg md:text-3xl">{copy.navigatorTitle}</h2>
          </div>
          <p class="kn-navigator__sub max-w-2xl text-sm leading-relaxed text-fg-dim">{copy.navigatorSub}</p>
        </div>
        <!-- Columns start at sm, not md: the compact phone layout ends at
             639px, so a md-first grid left 640–767px stacking full-size
             panels in a single column — taller than the phone it replaced. -->
        <div id="cluster-filter" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-7">
          <button class="cluster-btn rounded-xl border border-brass/45 bg-brass/[0.08] p-4 text-left transition-colors hover:border-brass" data-cluster="all" aria-pressed="true">
            <span class="font-mono text-[11px] uppercase tracking-widest text-brass">{copy.allClusters}</span>
            <span class="mt-2 block text-sm text-fg-dim">{t('cat.all')}</span>
          </button>
          {copy.clusters.map((cluster) => (
            <button class="cluster-btn rounded-xl border border-line bg-ink p-4 text-left transition-colors hover:border-brass" data-cluster={cluster.id} aria-pressed="false">
              <span class="font-display text-lg font-700 text-fg">{cluster.title}</span>
              <span class="mt-2 block text-xs leading-relaxed text-muted">{cluster.desc}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="cat-filter" class="mb-10 flex flex-wrap gap-2">
        <button class="cat-btn chip transition-colors hover:border-brass hover:text-brass" data-cat-filter="all" aria-pressed="true">{t('cat.all')}</button>
        {catKeys.map((c) => (
          <button class="cat-btn chip transition-colors hover:border-brass hover:text-brass" data-cat-filter={c} aria-pressed="false">{categoryLabel(c, lang)}</button>
        ))}
      </div>

      <div id="article-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((a, i) => (
          <div class="article-item" data-cat={a.data.category} data-clusters={clustersFor(a).join(' ')} data-search={articleSearch(a)}>
            <ArticleCard
              href={localizePath(`/knowledge/${slugOf(a.id)}`, lang)}
              title={a.data.title}
              description={a.data.description}
              category={categoryLabel(a.data.category, lang)}
              date={a.data.date}
              readingTime={a.data.readingTime}
              delay={(i % 3) * 80}
              lang={lang}
            />
          </div>
        ))}
      </div>
      <p id="knowledge-empty" class="hidden rounded-xl border border-line bg-ink-2 p-6 text-center text-fg-dim">{copy.empty}</p>

      <script is:inline>
        (function () {
          var btns = document.querySelectorAll('.cat-btn');
          var clusterBtns = document.querySelectorAll('.cluster-btn');
          var items = document.querySelectorAll('.article-item');
          var search = document.getElementById('knowledge-search');
          var count = document.getElementById('knowledge-count');
          var empty = document.getElementById('knowledge-empty');
          var activeCat = 'all';
          var activeCluster = 'all';
          var searchTimer = null;

          function track(eventName, params) {
            if (typeof window.gtag !== 'function') return;
            var payload = params || {};
            payload.language = document.documentElement.lang || '';
            payload.source_path = window.location.pathname;
            Object.keys(payload).forEach(function (key) {
              if (payload[key] === null || payload[key] === undefined || payload[key] === '') delete payload[key];
            });
            window.gtag('event', eventName, payload);
          }

          function setPressed(buttons, active) {
            buttons.forEach(function (x) {
              var on = x === active;
              x.setAttribute('aria-pressed', on ? 'true' : 'false');
              x.style.borderColor = on ? 'var(--color-brass)' : '';
              x.style.color = on ? 'var(--color-brass)' : '';
            });
          }

          function applyFilters() {
            var q = (search && search.value ? search.value : '').trim().toLowerCase();
            var visible = 0;
            items.forEach(function (it) {
              var catOk = activeCat === 'all' || it.getAttribute('data-cat') === activeCat;
              var clusterOk = activeCluster === 'all' || (it.getAttribute('data-clusters') || '').split(' ').indexOf(activeCluster) !== -1;
              var searchOk = !q || (it.getAttribute('data-search') || '').indexOf(q) !== -1;
              var show = catOk && clusterOk && searchOk;
              it.style.display = show ? '' : 'none';
              if (show) visible++;
            });
            if (count) count.textContent = String(visible);
            if (empty) empty.classList.toggle('hidden', visible !== 0);
          }

          btns.forEach(function (b) {
            b.addEventListener('click', function () {
              activeCat = b.getAttribute('data-cat-filter') || 'all';
              setPressed(btns, b);
              applyFilters();
              track('knowledge_category_filter', {
                event_category: 'knowledge',
                article_category: activeCat,
                active_cluster: activeCluster,
                result_count: count ? count.textContent : '',
              });
            });
          });

          clusterBtns.forEach(function (b) {
            b.addEventListener('click', function () {
              activeCluster = b.getAttribute('data-cluster') || 'all';
              setPressed(clusterBtns, b);
              applyFilters();
              track('knowledge_topic_cluster_click', {
                event_category: 'knowledge',
                topic_cluster: activeCluster,
                active_category: activeCat,
                result_count: count ? count.textContent : '',
              });
            });
          });

          if (search) search.addEventListener('input', function () {
            applyFilters();
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(function () {
              var q = search.value.trim();
              if (q.length < 2) return;
              track('knowledge_search_query', {
                event_category: 'search',
                search_term: q,
                active_cluster: activeCluster,
                active_category: activeCat,
                result_count: count ? count.textContent : '',
              });
            }, 700);
          });
          try {
            var initialQuery = new URLSearchParams(window.location.search).get('q');
            if (search && initialQuery) {
              search.value = initialQuery;
              window.gtag && window.gtag('event', 'knowledge_url_search', {
                event_category: 'search',
                search_term: initialQuery,
                language: document.documentElement.lang || '',
                source_path: window.location.pathname
              });
            }
          } catch (_) {}
          applyFilters();
        })();
      </script>
    </section>
  )}
</Layout>

<style>
  .kn-hub {
    display: grid;
    gap: 0.8rem;
    margin-top: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .kn-cats__title { margin-top: 2.2rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); }
  .kn-cats { margin-top: 0.8rem; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .kn-cats__link { display: block; border: 1px solid var(--color-line); border-radius: 0.75rem; padding: 0.85rem 1rem; text-decoration: none; background: rgba(255,255,255,0.022); transition: border-color 0.25s, background 0.25s; }
  .kn-cats__link:hover { border-color: var(--color-brass); background: rgba(201,164,92,0.06); }
  .kn-cats__link strong { display: block; font-family: var(--font-display); font-size: 0.96rem; font-weight: 700; color: var(--color-fg); line-height: 1.35; }
  .kn-cats__link span { display: block; margin-top: 0.3rem; font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-brass); }

  .kn-hub__card {
    position: relative;
    display: grid;
    gap: 0.3rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 0.9rem;
    padding: 1rem 1.1rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
    text-decoration: none;
    transition: transform 0.25s var(--ease-out-expo), border-color 0.25s var(--ease-out-expo);
  }

  .kn-hub__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--color-brass) 50%, var(--color-line));
  }

  .kn-hub__card strong {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.2;
    color: var(--color-fg);
  }

  .kn-hub__card span {
    color: var(--color-fg-dim);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .kn-hub__card em {
    font-style: normal;
    color: var(--color-brass);
    font-size: 1.1rem;
    transition: transform 0.2s var(--ease-out-expo);
  }

  .kn-hub__card:hover em {
    transform: translateX(4px);
  }

  /* ============================================================
     Phone layout
     ------------------------------------------------------------
     This is an index: 38 entries, six topic filters, five section
     links and four hub cards. At desktop widths they sit in two
     and three columns and the page is 8,350px. Stacked into one
     column on a phone the same page was 19,214px — 13,644px of it
     the article grid alone, because each entry rendered at full
     card size with its description.

     Nothing is removed below; the entries get index density
     instead of card density, and the filters become one swipeable
     row. Everything here is inside the query — desktop untouched.
     ============================================================ */
  @media (max-width: 639px) {
    /* --- Hub cards: the arrow had a grid row to itself --- */
    .kn-hub {
      gap: 0.5rem;
      margin-top: 1.5rem;
    }

    .kn-hub__card {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "title arrow"
        "desc  arrow";
      align-items: center;
      gap: 0.15rem 0.8rem;
      padding: 0.8rem 0.95rem;
    }

    .kn-hub__card strong {
      grid-area: title;
      font-size: 0.95rem;
    }

    .kn-hub__card span {
      grid-area: desc;
      font-size: 0.8rem;
      line-height: 1.35;
    }

    .kn-hub__card em {
      grid-area: arrow;
      align-self: center;
